{
  "suite": "pgbench-graph-graphalytics",
  "description": "LDBC Graphalytics algorithmic graph suite (BFS, WCC, SSSP, PageRank, LCC) using pure SQL",
  "scale": 1,
  "no_vacuum": true,
  "clients": 2,
  "threads": 2,
  "transactions": 1,
  "init_steps": [
    {
      "name": "schema",
      "file": "pgbench_graph_schema.sql"
    },
    {
      "name": "data",
      "file": "pgbench_graph_init.sql",
      "clients": 4,
      "threads": 4,
      "variables": {
        "num_workers": 4
      }
    },
    {
      "name": "constraints",
      "file": "pgbench_graph_constraints.sql"
    }
  ],
  "scripts": [
    {
      "file": "pgbench_ldbc_graphalytics.sql",
      "weight": 1
    }
  ],
  "sla": [
    "validation_failures<=0"
  ]
}

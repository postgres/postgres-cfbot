-- Test incorrect specifications
SET protocol_backend_compression = 'zstd:999';
ERROR:  invalid compression specification: compression algorithm "zstd" expects a compression level between -131072 and 22 (default at 3)
SET protocol_backend_compression = 'lz4:999';
ERROR:  invalid compression specification: compression algorithm "lz4" expects a compression level between 1 and 12 (default at 0)
SET protocol_backend_compression = 'zstd:lvel=1';
ERROR:  invalid compression specification: unrecognized compression option: "lvel"
SET protocol_backend_compression = 'zstd:workers=4';
ERROR:  protocol compression does not support compression workers
SET protocol_backend_compression = 'zstd:long=3';
ERROR:  invalid compression specification: value for compression option "long" must be a Boolean value
SET protocol_backend_compression = 'lz4:long=1';
ERROR:  invalid compression specification: compression algorithm "lz4" does not support long-distance mode
SET protocol_backend_compression = 'lz4:workers=1';
ERROR:  invalid compression specification: compression algorithm "lz4" does not accept a worker count
SET protocol_backend_compression = 'none:long=1';
ERROR:  invalid compression specification: compression algorithm "none" does not support long-distance mode
SET protocol_backend_compression = 'none:workers=1';
ERROR:  invalid compression specification: compression algorithm "none" does not accept a worker count
SET protocol_backend_compression = 'none:2';
ERROR:  invalid compression specification: compression algorithm "none" does not accept a compression level
-- Test compressor context teardown/setup
SET protocol_backend_compression = 'zstd';
SET protocol_backend_compression = 'none';
SET protocol_backend_compression = 'lz4';
SET protocol_backend_compression = 'none';
SET protocol_backend_compression = 'zstd';
SET protocol_backend_compression = 'lz4';
-- Test enabling/disabling long distance
SET protocol_backend_compression = 'zstd:level=19,long=1';
SELECT 1;
 ?column? 
----------
        1
(1 row)

SET protocol_backend_compression = 'zstd:level=19,long=0';
SELECT 1;
 ?column? 
----------
        1
(1 row)

-- Test changing lz4 compression level
SET protocol_backend_compression = 'lz4:level=12';
SELECT 1;
 ?column? 
----------
        1
(1 row)

SET protocol_backend_compression = 'lz4:level=2';
SELECT 1;

--
-- Tests for OR-clause expansion into UNION ALL Append paths
--
-- Initial GUC check
SHOW or_expansion_limit;
 or_expansion_limit 
--------------------
 8
(1 row)

CREATE TABLE orexp_a (id int, val int);
CREATE TABLE orexp_b (x int, y int, val int);
INSERT INTO orexp_a VALUES
  (1, 10),
  (2, 20),
  (3, 30),
  (4, NULL),
  (5, 50);
INSERT INTO orexp_b VALUES
  (1, 99, 100),
  (99, 2, 200),
  (3, 3, 300),
  (4, 99, 400),
  (99, 99, 500),
  (NULL, NULL, 600);
--
-- Basic OR-clause expansion
--
-- Disjunction on join keys across two tables
EXPLAIN (COSTS OFF)
SELECT a.id, b.x, b.y FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y
ORDER BY a.id, b.x, b.y;
                        QUERY PLAN                         
-----------------------------------------------------------
 Sort
   Sort Key: a.id, b.x, b.y
   ->  Append
         ->  Merge Join
               Merge Cond: (b.x = a.id)
               ->  Sort
                     Sort Key: b.x
                     ->  Seq Scan on orexp_b b
               ->  Sort
                     Sort Key: a.id
                     ->  Seq Scan on orexp_a a
         ->  Merge Join
               Merge Cond: (b_1.y = a_1.id)
               Join Filter: ((a_1.id = b_1.x) IS NOT TRUE)
               ->  Sort
                     Sort Key: b_1.y
                     ->  Seq Scan on orexp_b b_1
               ->  Sort
                     Sort Key: a_1.id
                     ->  Seq Scan on orexp_a a_1
(20 rows)

SELECT a.id, b.x, b.y FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y
ORDER BY a.id, b.x, b.y;
 id | x  | y  
----+----+----
  1 |  1 | 99
  2 | 99 |  2
  3 |  3 |  3
  4 |  4 | 99
(4 rows)

-- Compare with expansion disabled to confirm semantic equivalence
SET or_expansion_limit = 0;
EXPLAIN (COSTS OFF)
SELECT a.id, b.x, b.y FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y
ORDER BY a.id, b.x, b.y;
                     QUERY PLAN                      
-----------------------------------------------------
 Sort
   Sort Key: a.id, b.x, b.y
   ->  Nested Loop
         Join Filter: ((a.id = b.x) OR (a.id = b.y))
         ->  Seq Scan on orexp_a a
         ->  Materialize
               ->  Seq Scan on orexp_b b
(7 rows)

SELECT a.id, b.x, b.y FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y
ORDER BY a.id, b.x, b.y;
 id | x  | y  
----+----+----
  1 |  1 | 99
  2 | 99 |  2
  3 |  3 |  3
  4 |  4 | 99
(4 rows)

RESET or_expansion_limit;
--
-- Three-valued logic and duplicate elimination
--
-- Row (3, 30) from orexp_a and (3, 3, 300) from orexp_b satisfies both arms:
-- a.id = b.x (3 = 3) AND a.id = b.y (3 = 3).
-- The (a.id = b.x) IS NOT TRUE exclusion condition in the second arm ensures
-- it is emitted exactly once. Rows with NULLs are correctly handled.
EXPLAIN (COSTS OFF)
SELECT a.id, a.val, b.x, b.y, b.val
FROM orexp_a a, orexp_b b
WHERE (a.id = b.x OR a.id = b.y) AND (a.val IS NOT NULL OR b.val > 200)
ORDER BY a.id, b.x, b.y;
                                                 QUERY PLAN                                                 
------------------------------------------------------------------------------------------------------------
 Sort
   Sort Key: a.id, b.x, b.y
   ->  Append
         ->  Merge Join
               Merge Cond: (b.x = a.id)
               Join Filter: ((a.val IS NOT NULL) OR (b.val > 200))
               ->  Sort
                     Sort Key: b.x
                     ->  Seq Scan on orexp_b b
               ->  Sort
                     Sort Key: a.id
                     ->  Seq Scan on orexp_a a
         ->  Merge Join
               Merge Cond: (b_1.y = a_1.id)
               Join Filter: (((a_1.val IS NOT NULL) OR (b_1.val > 200)) AND ((a_1.id = b_1.x) IS NOT TRUE))
               ->  Sort
                     Sort Key: b_1.y
                     ->  Seq Scan on orexp_b b_1
               ->  Sort
                     Sort Key: a_1.id
                     ->  Seq Scan on orexp_a a_1
(21 rows)

SELECT a.id, a.val, b.x, b.y, b.val
FROM orexp_a a, orexp_b b
WHERE (a.id = b.x OR a.id = b.y) AND (a.val IS NOT NULL OR b.val > 200)
ORDER BY a.id, b.x, b.y;
 id | val | x  | y  | val 
----+-----+----+----+-----
  1 |  10 |  1 | 99 | 100
  2 |  20 | 99 |  2 | 200
  3 |  30 |  3 |  3 | 300
  4 |     |  4 | 99 | 400
(4 rows)

--
-- Multi-arm expansion (3 arms)
--
-- Arm 2 excludes Arm 0; Arm 3 excludes both Arm 0 and Arm 1.
EXPLAIN (COSTS OFF)
SELECT a.id, b.x, b.y, b.val FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y OR a.val = b.val
ORDER BY a.id, b.x, b.y, b.val;
                                           QUERY PLAN                                           
------------------------------------------------------------------------------------------------
 Sort
   Sort Key: a.id, b.x, b.y, b.val
   ->  Append
         ->  Merge Join
               Merge Cond: (b.x = a.id)
               ->  Sort
                     Sort Key: b.x
                     ->  Seq Scan on orexp_b b
               ->  Sort
                     Sort Key: a.id
                     ->  Seq Scan on orexp_a a
         ->  Merge Join
               Merge Cond: (b_1.y = a_1.id)
               Join Filter: ((a_1.id = b_1.x) IS NOT TRUE)
               ->  Sort
                     Sort Key: b_1.y
                     ->  Seq Scan on orexp_b b_1
               ->  Sort
                     Sort Key: a_1.id
                     ->  Seq Scan on orexp_a a_1
         ->  Merge Join
               Merge Cond: (b_2.val = a_2.val)
               Join Filter: (((a_2.id = b_2.x) IS NOT TRUE) AND ((a_2.id = b_2.y) IS NOT TRUE))
               ->  Sort
                     Sort Key: b_2.val
                     ->  Seq Scan on orexp_b b_2
               ->  Sort
                     Sort Key: a_2.val
                     ->  Seq Scan on orexp_a a_2
(29 rows)

SELECT a.id, b.x, b.y, b.val FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y OR a.val = b.val
ORDER BY a.id, b.x, b.y, b.val;
 id | x  | y  | val 
----+----+----+-----
  1 |  1 | 99 | 100
  2 | 99 |  2 | 200
  3 |  3 |  3 | 300
  4 |  4 | 99 | 400
(4 rows)

--
-- Target list projection and expressions
--
-- Column order differs from scan order and includes cross-table expressions
EXPLAIN (COSTS OFF)
SELECT b.y, a.id + b.x AS sum_id_x, a.val, 'tag' AS literal
FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y
ORDER BY sum_id_x, b.y;
                           QUERY PLAN                            
-----------------------------------------------------------------
 Sort
   Sort Key: ((a.id + b.x)), b.y
   ->  Result
         ->  Append
               ->  Merge Join
                     Merge Cond: (b.x = a.id)
                     ->  Sort
                           Sort Key: b.x
                           ->  Seq Scan on orexp_b b
                     ->  Sort
                           Sort Key: a.id
                           ->  Seq Scan on orexp_a a
               ->  Merge Join
                     Merge Cond: (b_1.y = a_1.id)
                     Join Filter: ((a_1.id = b_1.x) IS NOT TRUE)
                     ->  Sort
                           Sort Key: b_1.y
                           ->  Seq Scan on orexp_b b_1
                     ->  Sort
                           Sort Key: a_1.id
                           ->  Seq Scan on orexp_a a_1
(21 rows)

SELECT b.y, a.id + b.x AS sum_id_x, a.val, 'tag' AS literal
FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y
ORDER BY sum_id_x, b.y;
 y  | sum_id_x | val | literal 
----+----------+-----+---------
 99 |        2 |  10 | tag
  3 |        6 |  30 | tag
 99 |        8 |     | tag
  2 |      101 |  20 | tag
(4 rows)

-- Whole-row references
EXPLAIN (COSTS OFF)
SELECT a.*, b.* FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y
ORDER BY a.id, b.x, b.y;
                        QUERY PLAN                         
-----------------------------------------------------------
 Sort
   Sort Key: a.id, b.x, b.y
   ->  Append
         ->  Merge Join
               Merge Cond: (b.x = a.id)
               ->  Sort
                     Sort Key: b.x
                     ->  Seq Scan on orexp_b b
               ->  Sort
                     Sort Key: a.id
                     ->  Seq Scan on orexp_a a
         ->  Merge Join
               Merge Cond: (b_1.y = a_1.id)
               Join Filter: ((a_1.id = b_1.x) IS NOT TRUE)
               ->  Sort
                     Sort Key: b_1.y
                     ->  Seq Scan on orexp_b b_1
               ->  Sort
                     Sort Key: a_1.id
                     ->  Seq Scan on orexp_a a_1
(20 rows)

--
-- Upper planner nodes and cost propagation
--
-- Fast-start with LIMIT: tuple_fraction and limit_tuples passed to arms
EXPLAIN (COSTS OFF)
SELECT a.id, b.x, b.y FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y
LIMIT 2;
                     QUERY PLAN                      
-----------------------------------------------------
 Limit
   ->  Nested Loop
         Join Filter: ((a.id = b.x) OR (a.id = b.y))
         ->  Seq Scan on orexp_a a
         ->  Materialize
               ->  Seq Scan on orexp_b b
(6 rows)

-- GROUP BY and aggregate atop expanded join
EXPLAIN (COSTS OFF)
SELECT a.id, count(*), sum(b.val) FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y
GROUP BY a.id
ORDER BY a.id;
                           QUERY PLAN                            
-----------------------------------------------------------------
 Sort
   Sort Key: a.id
   ->  HashAggregate
         Group Key: a.id
         ->  Append
               ->  Merge Join
                     Merge Cond: (b.x = a.id)
                     ->  Sort
                           Sort Key: b.x
                           ->  Seq Scan on orexp_b b
                     ->  Sort
                           Sort Key: a.id
                           ->  Seq Scan on orexp_a a
               ->  Merge Join
                     Merge Cond: (b_1.y = a_1.id)
                     Join Filter: ((a_1.id = b_1.x) IS NOT TRUE)
                     ->  Sort
                           Sort Key: b_1.y
                           ->  Seq Scan on orexp_b b_1
                     ->  Sort
                           Sort Key: a_1.id
                           ->  Seq Scan on orexp_a a_1
(22 rows)

SELECT a.id, count(*), sum(b.val) FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y
GROUP BY a.id
ORDER BY a.id;
 id | count | sum 
----+-------+-----
  1 |     1 | 100
  2 |     1 | 200
  3 |     1 | 300
  4 |     1 | 400
(4 rows)

-- Zero-column target (count(*))
EXPLAIN (COSTS OFF)
SELECT count(*) FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y;
                        QUERY PLAN                         
-----------------------------------------------------------
 Aggregate
   ->  Append
         ->  Merge Join
               Merge Cond: (b.x = a.id)
               ->  Sort
                     Sort Key: b.x
                     ->  Seq Scan on orexp_b b
               ->  Sort
                     Sort Key: a.id
                     ->  Seq Scan on orexp_a a
         ->  Merge Join
               Merge Cond: (b_1.y = a_1.id)
               Join Filter: ((a_1.id = b_1.x) IS NOT TRUE)
               ->  Sort
                     Sort Key: b_1.y
                     ->  Seq Scan on orexp_b b_1
               ->  Sort
                     Sort Key: a_1.id
                     ->  Seq Scan on orexp_a a_1
(19 rows)

SELECT count(*) FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y;
 count 
-------
     4
(1 row)

--
-- Outer joins
--
-- LEFT JOIN where WHERE clause contains cross-relation disjunction
EXPLAIN (COSTS OFF)
SELECT a.id, b.x, b.y FROM orexp_a a LEFT JOIN orexp_b b ON a.id = b.x
WHERE b.val = 100 OR a.id = 2
ORDER BY 1, 2, 3;
                     QUERY PLAN                      
-----------------------------------------------------
 Sort
   Sort Key: a.id, b.x, b.y
   ->  Append
         ->  Hash Join
               Hash Cond: (a.id = b.x)
               ->  Seq Scan on orexp_a a
               ->  Hash
                     ->  Seq Scan on orexp_b b
                           Filter: (val = 100)
         ->  Nested Loop Left Join
               Filter: ((b_1.val = 100) IS NOT TRUE)
               ->  Seq Scan on orexp_a a_1
                     Filter: (id = 2)
               ->  Materialize
                     ->  Seq Scan on orexp_b b_1
                           Filter: (x = 2)
(16 rows)

SELECT a.id, b.x, b.y FROM orexp_a a LEFT JOIN orexp_b b ON a.id = b.x
WHERE b.val = 100 OR a.id = 2
ORDER BY 1, 2, 3;
 id | x | y  
----+---+----
  1 | 1 | 99
  2 |   |   
(2 rows)

-- FULL JOIN reduced to INNER join by strict WHERE quals
EXPLAIN (COSTS OFF)
SELECT a.id, b.y FROM orexp_a a FULL JOIN orexp_b b ON a.id = b.x
WHERE a.id = b.y OR b.x = a.id
ORDER BY 1, 2;
                     QUERY PLAN                      
-----------------------------------------------------
 Incremental Sort
   Sort Key: a.id, b.y
   Presorted Key: a.id
   ->  Merge Join
         Merge Cond: (b.x = a.id)
         Join Filter: ((a.id = b.y) OR (b.x = a.id))
         ->  Sort
               Sort Key: b.x
               ->  Seq Scan on orexp_b b
         ->  Sort
               Sort Key: a.id
               ->  Seq Scan on orexp_a a
(12 rows)

SELECT a.id, b.y FROM orexp_a a FULL JOIN orexp_b b ON a.id = b.x
WHERE a.id = b.y OR b.x = a.id
ORDER BY 1, 2;
 id | y  
----+----
  1 | 99
  3 |  3
  4 | 99
(3 rows)

--
-- Subqueries and derived tables
--
-- Pulled-up subquery participating in disjunction
EXPLAIN (COSTS OFF)
SELECT sub.id, b.y FROM (SELECT id, val FROM orexp_a) sub, orexp_b b
WHERE sub.id = b.x OR sub.val = b.y
ORDER BY 1, 2;
                           QUERY PLAN                            
-----------------------------------------------------------------
 Sort
   Sort Key: orexp_a.id, b.y
   ->  Append
         ->  Merge Join
               Merge Cond: (b.x = orexp_a.id)
               ->  Sort
                     Sort Key: b.x
                     ->  Seq Scan on orexp_b b
               ->  Sort
                     Sort Key: orexp_a.id
                     ->  Seq Scan on orexp_a
         ->  Merge Join
               Merge Cond: (b_1.y = orexp_a_1.val)
               Join Filter: ((orexp_a_1.id = b_1.x) IS NOT TRUE)
               ->  Sort
                     Sort Key: b_1.y
                     ->  Seq Scan on orexp_b b_1
               ->  Sort
                     Sort Key: orexp_a_1.val
                     ->  Seq Scan on orexp_a orexp_a_1
(20 rows)

SELECT sub.id, b.y FROM (SELECT id, val FROM orexp_a) sub, orexp_b b
WHERE sub.id = b.x OR sub.val = b.y
ORDER BY 1, 2;
 id | y  
----+----
  1 | 99
  3 |  3
  4 | 99
(3 rows)

-- Derived table from VALUES list
EXPLAIN (COSTS OFF)
SELECT v.a, b.y FROM (VALUES (1, 99), (2, NULL), (3, 3)) v(a, b), orexp_b b
WHERE v.a = b.x OR v.b = b.y
ORDER BY 1, 2;
                               QUERY PLAN                                
-------------------------------------------------------------------------
 Sort
   Sort Key: "*VALUES*".column1, b.y
   ->  Append
         ->  Hash Join
               Hash Cond: (b.x = "*VALUES*".column1)
               ->  Seq Scan on orexp_b b
               ->  Hash
                     ->  Values Scan on "*VALUES*"
         ->  Hash Join
               Hash Cond: (b_1.y = "*VALUES*_1".column2)
               Join Filter: (("*VALUES*_1".column1 = b_1.x) IS NOT TRUE)
               ->  Seq Scan on orexp_b b_1
               ->  Hash
                     ->  Values Scan on "*VALUES*_1"
(14 rows)

SELECT v.a, b.y FROM (VALUES (1, 99), (2, NULL), (3, 3)) v(a, b), orexp_b b
WHERE v.a = b.x OR v.b = b.y
ORDER BY 1, 2;
 a | y  
---+----
 1 | 99
 1 | 99
 1 | 99
 3 |  3
(4 rows)

--
-- Partitioned and inheritance tables
--
-- Partitioned table
CREATE TABLE orexp_part (id int, d int) PARTITION BY RANGE (d);
CREATE TABLE orexp_part1 PARTITION OF orexp_part FOR VALUES FROM (0) TO (10);
CREATE TABLE orexp_part2 PARTITION OF orexp_part FOR VALUES FROM (10) TO (20);
INSERT INTO orexp_part VALUES (1, 5), (2, 15);
EXPLAIN (COSTS OFF)
SELECT a.id, p.d FROM orexp_a a, orexp_part p
WHERE a.id = p.id OR a.val = p.d;
                      QUERY PLAN                      
------------------------------------------------------
 Append
   ->  Merge Join
         Merge Cond: (a.id = p.id)
         ->  Sort
               Sort Key: a.id
               ->  Seq Scan on orexp_a a
         ->  Sort
               Sort Key: p.id
               ->  Append
                     ->  Seq Scan on orexp_part1 p_1
                     ->  Seq Scan on orexp_part2 p_2
   ->  Merge Join
         Merge Cond: (a_1.val = p_3.d)
         Join Filter: ((a_1.id = p_3.id) IS NOT TRUE)
         ->  Sort
               Sort Key: a_1.val
               ->  Seq Scan on orexp_a a_1
         ->  Sort
               Sort Key: p_3.d
               ->  Append
                     ->  Seq Scan on orexp_part1 p_4
                     ->  Seq Scan on orexp_part2 p_5
(22 rows)

DROP TABLE orexp_part;
-- Table inheritance
CREATE TABLE orexp_inh_parent (id int, val int);
CREATE TABLE orexp_inh_child () INHERITS (orexp_inh_parent);
INSERT INTO orexp_inh_parent VALUES (1, 10);
INSERT INTO orexp_inh_child VALUES (2, 20);
EXPLAIN (COSTS OFF)
SELECT a.id, p.val FROM orexp_a a, orexp_inh_parent p
WHERE a.id = p.id OR a.val = p.val;
                        QUERY PLAN                        
----------------------------------------------------------
 Append
   ->  Merge Join
         Merge Cond: (a.id = p.id)
         ->  Sort
               Sort Key: a.id
               ->  Seq Scan on orexp_a a
         ->  Sort
               Sort Key: p.id
               ->  Append
                     ->  Seq Scan on orexp_inh_parent p_1
                     ->  Seq Scan on orexp_inh_child p_2
   ->  Merge Join
         Merge Cond: (a_1.val = p_3.val)
         Join Filter: ((a_1.id = p_3.id) IS NOT TRUE)
         ->  Sort
               Sort Key: a_1.val
               ->  Seq Scan on orexp_a a_1
         ->  Sort
               Sort Key: p_3.val
               ->  Append
                     ->  Seq Scan on orexp_inh_parent p_4
                     ->  Seq Scan on orexp_inh_child p_5
(22 rows)

DROP TABLE orexp_inh_parent CASCADE;
NOTICE:  drop cascades to table orexp_inh_child
--
-- Parallel Append
--
-- Encourage parallel query and parallel append
BEGIN;
SET LOCAL parallel_setup_cost = 0;
SET LOCAL parallel_tuple_cost = 0;
SET LOCAL min_parallel_table_scan_size = 0;
SET LOCAL max_parallel_workers_per_gather = 2;
SET LOCAL enable_parallel_append = on;
EXPLAIN (COSTS OFF)
SELECT a.id, b.x, b.y FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y
ORDER BY a.id, b.x, b.y;
                           QUERY PLAN                           
----------------------------------------------------------------
 Gather Merge
   Workers Planned: 2
   ->  Sort
         Sort Key: a.id, b.x, b.y
         ->  Parallel Append
               ->  Parallel Hash Join
                     Hash Cond: (a.id = b.y)
                     Join Filter: ((a.id = b.x) IS NOT TRUE)
                     ->  Parallel Seq Scan on orexp_a a
                     ->  Parallel Hash
                           ->  Parallel Seq Scan on orexp_b b
               ->  Parallel Hash Join
                     Hash Cond: (a_1.id = b_1.x)
                     ->  Parallel Seq Scan on orexp_a a_1
                     ->  Parallel Hash
                           ->  Parallel Seq Scan on orexp_b b_1
(16 rows)

SELECT a.id, b.x, b.y FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y
ORDER BY a.id, b.x, b.y;
 id | x  | y  
----+----+----
  1 |  1 | 99
  2 | 99 |  2
  3 |  3 |  3
  4 |  4 | 99
(4 rows)

COMMIT;
--
-- Pulled-up UNION ALL append relation
--
EXPLAIN (COSTS OFF)
SELECT u.id, a.val FROM (SELECT x AS id, val FROM orexp_b
                         UNION ALL
                         SELECT id, val FROM orexp_a) u, orexp_a a
WHERE u.val = a.val OR u.id = a.id
ORDER BY u.id, a.val;
                             QUERY PLAN                             
--------------------------------------------------------------------
 Sort
   Sort Key: orexp_b.x, a.val
   ->  Append
         ->  Merge Join
               Merge Cond: (a.val = orexp_b.val)
               ->  Sort
                     Sort Key: a.val
                     ->  Seq Scan on orexp_a a
               ->  Sort
                     Sort Key: orexp_b.val
                     ->  Append
                           ->  Seq Scan on orexp_b
                           ->  Seq Scan on orexp_a
         ->  Merge Join
               Merge Cond: (a_1.id = orexp_b_1.x)
               Join Filter: ((orexp_b_1.val = a_1.val) IS NOT TRUE)
               ->  Sort
                     Sort Key: a_1.id
                     ->  Seq Scan on orexp_a a_1
               ->  Sort
                     Sort Key: orexp_b_1.x
                     ->  Append
                           ->  Seq Scan on orexp_b orexp_b_1
                           ->  Seq Scan on orexp_a orexp_a_1
(24 rows)

SELECT u.id, a.val FROM (SELECT x AS id, val FROM orexp_b
                         UNION ALL
                         SELECT id, val FROM orexp_a) u, orexp_a a
WHERE u.val = a.val OR u.id = a.id
ORDER BY u.id, a.val;
 id | val 
----+-----
  1 |  10
  1 |  10
  2 |  20
  3 |  30
  3 |  30
  4 |    
  4 |    
  5 |  50
(8 rows)

--
-- LATERAL reference
--
EXPLAIN (COSTS OFF)
SELECT a.id, l.ly FROM orexp_a a,
       LATERAL (SELECT b.y AS ly FROM orexp_b b WHERE b.x = a.id OR b.y = a.val) l
WHERE a.id = l.ly OR a.val = 1
ORDER BY a.id, l.ly;
                                               QUERY PLAN                                                
---------------------------------------------------------------------------------------------------------
 Sort
   Sort Key: a.id, b.y
   ->  Append
         ->  Merge Join
               Merge Cond: (b.y = a.id)
               Join Filter: ((b.x = a.id) OR (b.y = a.val))
               ->  Sort
                     Sort Key: b.y
                     ->  Seq Scan on orexp_b b
               ->  Sort
                     Sort Key: a.id
                     ->  Seq Scan on orexp_a a
         ->  Nested Loop
               Join Filter: (((a_1.id = b_1.y) IS NOT TRUE) AND ((b_1.x = a_1.id) OR (b_1.y = a_1.val)))
               ->  Seq Scan on orexp_b b_1
               ->  Materialize
                     ->  Seq Scan on orexp_a a_1
                           Filter: (val = 1)
(18 rows)

SELECT a.id, l.ly FROM orexp_a a,
       LATERAL (SELECT b.y AS ly FROM orexp_b b WHERE b.x = a.id OR b.y = a.val) l
WHERE a.id = l.ly OR a.val = 1
ORDER BY a.id, l.ly;
 id | ly 
----+----
  3 |  3
(1 row)

--
-- Ineligible queries (safety gates correctly bypass expansion)
--
-- Volatile function in WHERE
EXPLAIN (COSTS OFF)
SELECT a.id, b.y FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR (a.id = b.y AND random() < 0.5);
                                        QUERY PLAN                                        
------------------------------------------------------------------------------------------
 Nested Loop
   Join Filter: ((a.id = b.x) OR ((a.id = b.y) AND (random() < '0.5'::double precision)))
   ->  Seq Scan on orexp_a a
   ->  Materialize
         ->  Seq Scan on orexp_b b
(5 rows)

-- Correlated SubPlan in WHERE
EXPLAIN (COSTS OFF)
SELECT a.id, b.y FROM orexp_a a, orexp_b b
WHERE (a.id = b.x OR a.id = b.y)
  AND a.val > (SELECT max(b2.val) FROM orexp_b b2 WHERE b2.x = a.id);
                    QUERY PLAN                    
--------------------------------------------------
 Nested Loop
   Join Filter: ((a.id = b.x) OR (a.id = b.y))
   ->  Seq Scan on orexp_b b
   ->  Materialize
         ->  Seq Scan on orexp_a a
               Filter: (val > (SubPlan expr_1))
               SubPlan expr_1
                 ->  Aggregate
                       ->  Seq Scan on orexp_b b2
                             Filter: (x = a.id)
(10 rows)

-- TABLESAMPLE
EXPLAIN (COSTS OFF)
SELECT a.id, b.y FROM orexp_a a, orexp_b b TABLESAMPLE SYSTEM (50)
WHERE a.id = b.x OR a.id = b.y;
                  QUERY PLAN                   
-----------------------------------------------
 Nested Loop
   Join Filter: ((a.id = b.x) OR (a.id = b.y))
   ->  Seq Scan on orexp_a a
   ->  Materialize
         ->  Sample Scan on orexp_b b
               Sampling: system ('50'::real)
(6 rows)

-- Unreduced FULL JOIN
EXPLAIN (COSTS OFF)
SELECT a.id, b.y FROM orexp_a a FULL JOIN orexp_b b ON a.id = b.x
WHERE a.val IS NULL OR b.val IS NULL;
                   QUERY PLAN                   
------------------------------------------------
 Merge Full Join
   Merge Cond: (b.x = a.id)
   Filter: ((a.val IS NULL) OR (b.val IS NULL))
   ->  Sort
         Sort Key: b.x
         ->  Seq Scan on orexp_b b
   ->  Sort
         Sort Key: a.id
         ->  Seq Scan on orexp_a a
(9 rows)

-- Active unflattened subquery with grouping
EXPLAIN (COSTS OFF)
SELECT a.id, s.n FROM orexp_a a,
       (SELECT x AS sx, count(*) AS n FROM orexp_b GROUP BY x) s
WHERE a.id = s.sx OR a.val = s.n;
                   QUERY PLAN                    
-------------------------------------------------
 Nested Loop
   Join Filter: ((a.id = s.sx) OR (a.val = s.n))
   ->  Seq Scan on orexp_a a
   ->  Materialize
         ->  Subquery Scan on s
               ->  HashAggregate
                     Group Key: orexp_b.x
                     ->  Seq Scan on orexp_b
(8 rows)

--
-- GUC limit control
--
-- Arm count exceeds limit: expansion skipped
SET or_expansion_limit = 2;
EXPLAIN (COSTS OFF)
SELECT a.id, b.x, b.y, b.val FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y OR a.val = b.val
ORDER BY a.id, b.x, b.y, b.val;
                               QUERY PLAN                               
------------------------------------------------------------------------
 Sort
   Sort Key: a.id, b.x, b.y, b.val
   ->  Nested Loop
         Join Filter: ((a.id = b.x) OR (a.id = b.y) OR (a.val = b.val))
         ->  Seq Scan on orexp_a a
         ->  Materialize
               ->  Seq Scan on orexp_b b
(7 rows)

-- Arm count within limit: expansion applied
SET or_expansion_limit = 3;
EXPLAIN (COSTS OFF)
SELECT a.id, b.x, b.y, b.val FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y OR a.val = b.val
ORDER BY a.id, b.x, b.y, b.val;
                                           QUERY PLAN                                           
------------------------------------------------------------------------------------------------
 Sort
   Sort Key: a.id, b.x, b.y, b.val
   ->  Append
         ->  Merge Join
               Merge Cond: (b.x = a.id)
               ->  Sort
                     Sort Key: b.x
                     ->  Seq Scan on orexp_b b
               ->  Sort
                     Sort Key: a.id
                     ->  Seq Scan on orexp_a a
         ->  Merge Join
               Merge Cond: (b_1.y = a_1.id)
               Join Filter: ((a_1.id = b_1.x) IS NOT TRUE)
               ->  Sort
                     Sort Key: b_1.y
                     ->  Seq Scan on orexp_b b_1
               ->  Sort
                     Sort Key: a_1.id
                     ->  Seq Scan on orexp_a a_1
         ->  Merge Join
               Merge Cond: (b_2.val = a_2.val)
               Join Filter: (((a_2.id = b_2.x) IS NOT TRUE) AND ((a_2.id = b_2.y) IS NOT TRUE))
               ->  Sort
                     Sort Key: b_2.val
                     ->  Seq Scan on orexp_b b_2
               ->  Sort
                     Sort Key: a_2.val
                     ->  Seq Scan on orexp_a a_2
(29 rows)

SELECT a.id, b.x, b.y, b.val FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y OR a.val = b.val
ORDER BY a.id, b.x, b.y, b.val;
 id | x  | y  | val 
----+----+----+-----
  1 |  1 | 99 | 100
  2 | 99 |  2 | 200
  3 |  3 |  3 | 300
  4 |  4 | 99 | 400
(4 rows)

RESET or_expansion_limit;
--
-- Clean up
--
DROP TABLE orexp_a, orexp_b;

-- non-table RTE_RESULT derived table
EXPLAIN (COSTS OFF)
SELECT a.id, b.y FROM orexp_a a, orexp_b b, (SELECT 1 AS one) x
WHERE a.id = b.x OR a.id = b.y
ORDER BY 1, 2;

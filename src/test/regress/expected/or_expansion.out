--
-- Non-table range table entries
--
-- VALUES RTE with nulls
EXPLAIN (COSTS OFF)
SELECT v.a, b.y FROM (VALUES (1, 99), (2, NULL), (3, 3), (NULL, 4)) v (a, b), orexp_b b
WHERE v.a = b.x OR v.b = b.y
ORDER BY 1, 2;
                               QUERY PLAN                                
-------------------------------------------------------------------------
 Sort
   Sort Key: "*VALUES*".column1, b.y
   ->  Append
         ->  Hash Join
               Hash Cond: (b.x = "*VALUES*".column1)
               ->  Seq Scan on orexp_b b
               ->  Hash
                     ->  Values Scan on "*VALUES*"
         ->  Hash Join
               Hash Cond: (b_1.y = "*VALUES*_1".column2)
               Join Filter: (("*VALUES*_1".column1 = b_1.x) IS NOT TRUE)
               ->  Seq Scan on orexp_b b_1
               ->  Hash
                     ->  Values Scan on "*VALUES*_1"
(14 rows)


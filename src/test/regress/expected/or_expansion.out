--------------------------------------------------------------------
 Sort
   Sort Key: a.id, b.x, b.y
   ->  Append
         ->  Nested Loop
               Join Filter: ((a.id = b.x) OR (a.val = b.y))
               ->  Seq Scan on orexp_a a
               ->  Materialize
                     ->  Seq Scan on orexp_b b
                           Filter: (val = 100)
         ->  Nested Loop Left Join
               Join Filter: ((a_1.id = b_1.x) OR (a_1.val = b_1.y))
               Filter: ((b_1.val = 100) IS NOT TRUE)
               ->  Seq Scan on orexp_a a_1
                     Filter: (id = 1)
               ->  Materialize
                     ->  Seq Scan on orexp_b b_1
(16 rows)

SELECT a.id, b.x, b.y FROM orexp_a a LEFT JOIN orexp_b b ON (a.id = b.x OR a.val = b.y)
WHERE b.val = 100 OR a.id = 1

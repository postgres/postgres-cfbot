-- pulled-up subquery containing outer join
CREATE TABLE orexp_c (id int, val int);
CREATE TABLE orexp_d (id int, val int);
INSERT INTO orexp_c VALUES (1, 10), (2, 20), (3, NULL);
INSERT INTO orexp_d VALUES (1, 100), (3, 300), (5, 500);
EXPLAIN (COSTS OFF)
SELECT x.cid, b.y FROM (SELECT c.id AS cid, c.val AS cval, d.val + 1 AS dval
                        FROM orexp_c c LEFT JOIN orexp_d d ON c.id = d.id) x,
                      orexp_b b
WHERE x.dval = b.y OR x.cid = b.x
ORDER BY 1, 2;
                         QUERY PLAN                          
-------------------------------------------------------------
 Sort
   Sort Key: c.id, b.y
   ->  Append
         ->  Merge Join
               Merge Cond: (c.id = d.id)
               ->  Sort
                     Sort Key: c.id
                     ->  Seq Scan on orexp_c c
               ->  Sort
                     Sort Key: d.id
                     ->  Merge Join
                           Merge Cond: (b.y = ((d.val + 1)))
                           ->  Sort
                                 Sort Key: b.y
                                 ->  Seq Scan on orexp_b b
                           ->  Sort
                                 Sort Key: ((d.val + 1))
                                 ->  Seq Scan on orexp_d d
         ->  Merge Right Join
               Merge Cond: (d_1.id = c_1.id)
               Filter: (((d_1.val + 1) = b_1.y) IS NOT TRUE)
               ->  Sort
                     Sort Key: d_1.id
                     ->  Seq Scan on orexp_d d_1
               ->  Materialize
                     ->  Merge Join
                           Merge Cond: (b_1.x = c_1.id)
                           ->  Sort
                                 Sort Key: b_1.x
                                 ->  Seq Scan on orexp_b b_1
                           ->  Sort
                                 Sort Key: c_1.id
                                 ->  Seq Scan on orexp_c c_1
(33 rows)

SELECT x.cid, b.y FROM (SELECT c.id AS cid, c.val AS cval, d.val + 1 AS dval
                        FROM orexp_c c LEFT JOIN orexp_d d ON c.id = d.id) x,
                      orexp_b b
WHERE x.dval = b.y OR x.cid = b.x
ORDER BY 1, 2;
 cid | y  
-----+----
   1 | 99
   3 |  3
(2 rows)

-- view expanded into pulled-up subquery
CREATE VIEW orexp_v AS
  SELECT a.id AS aid, a.val AS aval, b.x AS bx FROM orexp_a a, orexp_b b;
EXPLAIN (COSTS OFF)
SELECT v.aid, b.y FROM orexp_v v, orexp_b b
WHERE v.aval = b.y OR v.bx = b.y
ORDER BY 1, 2;
                         QUERY PLAN                         
------------------------------------------------------------
 Sort
   Sort Key: a.id, b.y
   ->  Append
         ->  Nested Loop
               ->  Merge Join
                     Merge Cond: (b.y = a.val)
                     ->  Sort
                           Sort Key: b.y
                           ->  Seq Scan on orexp_b b
                     ->  Sort
                           Sort Key: a.val
                           ->  Seq Scan on orexp_a a
               ->  Materialize
                     ->  Seq Scan on orexp_b b_1
         ->  Nested Loop
               Join Filter: ((a_1.val = b_2.y) IS NOT TRUE)
               ->  Merge Join
                     Merge Cond: (b_3.x = b_2.y)
                     ->  Sort
                           Sort Key: b_3.x
                           ->  Seq Scan on orexp_b b_3
                     ->  Sort
                           Sort Key: b_2.y
                           ->  Seq Scan on orexp_b b_2
               ->  Materialize
                     ->  Seq Scan on orexp_a a_1
(26 rows)

SELECT v.aid, b.y FROM orexp_v v, orexp_b b
WHERE v.aval = b.y OR v.bx = b.y
ORDER BY 1, 2;

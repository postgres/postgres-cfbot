--
-- Subqueries, views, and derived tables
--
-- pulled-up simple subquery
EXPLAIN (COSTS OFF)
SELECT x.id, b.y FROM (SELECT id, val FROM orexp_a) x, orexp_b b
WHERE x.id = b.x OR x.val = b.y
ORDER BY 1, 2;
                           QUERY PLAN                            
-----------------------------------------------------------------
 Sort
   Sort Key: orexp_a.id, b.y
   ->  Append
         ->  Merge Join
               Merge Cond: (b.x = orexp_a.id)
               ->  Sort
                     Sort Key: b.x
                     ->  Seq Scan on orexp_b b
               ->  Sort
                     Sort Key: orexp_a.id
                     ->  Seq Scan on orexp_a
         ->  Merge Join
               Merge Cond: (b_1.y = orexp_a_1.val)
               Join Filter: ((orexp_a_1.id = b_1.x) IS NOT TRUE)
               ->  Sort
                     Sort Key: b_1.y
                     ->  Seq Scan on orexp_b b_1
               ->  Sort
                     Sort Key: orexp_a_1.val
                     ->  Seq Scan on orexp_a orexp_a_1
(20 rows)

SELECT x.id, b.y FROM (SELECT id, val FROM orexp_a) x, orexp_b b
WHERE x.id = b.x OR x.val = b.y
ORDER BY 1, 2;

-- non-aggregate HAVING clause
EXPLAIN (COSTS OFF)
SELECT a.id, count(*) FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y
GROUP BY a.id
HAVING a.id > 1
ORDER BY a.id;
                           QUERY PLAN                            
-----------------------------------------------------------------
 Sort
   Sort Key: a.id
   ->  HashAggregate
         Group Key: a.id
         ->  Append
               ->  Merge Join
                     Merge Cond: (a.id = b.x)
                     ->  Sort
                           Sort Key: a.id
                           ->  Seq Scan on orexp_a a
                                 Filter: (id > 1)
                     ->  Sort
                           Sort Key: b.x
                           ->  Seq Scan on orexp_b b
               ->  Merge Join
                     Merge Cond: (a_1.id = b_1.y)
                     Join Filter: ((a_1.id = b_1.x) IS NOT TRUE)
                     ->  Sort
                           Sort Key: a_1.id
                           ->  Seq Scan on orexp_a a_1
                                 Filter: (id > 1)
                     ->  Sort
                           Sort Key: b_1.y
                           ->  Seq Scan on orexp_b b_1
(24 rows)

-- aggregate HAVING clause
EXPLAIN (COSTS OFF)
SELECT a.id, count(*) FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y
GROUP BY a.id
HAVING count(*) > 1
ORDER BY a.id;
                           QUERY PLAN                            
-----------------------------------------------------------------
 Sort
   Sort Key: a.id
   ->  HashAggregate
         Group Key: a.id
         Filter: (count(*) > 1)
         ->  Append
               ->  Merge Join
                     Merge Cond: (b.x = a.id)
                     ->  Sort
                           Sort Key: b.x
                           ->  Seq Scan on orexp_b b
                     ->  Sort
                           Sort Key: a.id
                           ->  Seq Scan on orexp_a a
               ->  Merge Join
                     Merge Cond: (b_1.y = a_1.id)
                     Join Filter: ((a_1.id = b_1.x) IS NOT TRUE)
                     ->  Sort
                           Sort Key: b_1.y
                           ->  Seq Scan on orexp_b b_1
                     ->  Sort
                           Sort Key: a_1.id
                           ->  Seq Scan on orexp_a a_1
(23 rows)

-- grouping sets
EXPLAIN (COSTS OFF)
SELECT a.id, b.x, grouping (a.id), count(*) FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y
GROUP BY GROUPING SETS ((a.id), (b.x), ())
ORDER BY 1, 2, 3, 4;
                           QUERY PLAN                            
-----------------------------------------------------------------
 Sort
   Sort Key: a.id, b.x, (GROUPING(a.id)), (count(*))
   ->  MixedAggregate
         Hash Key: a.id
         Hash Key: b.x
         Group Key: ()
         ->  Append
               ->  Merge Join
                     Merge Cond: (b.x = a.id)
                     ->  Sort
                           Sort Key: b.x
                           ->  Seq Scan on orexp_b b
                     ->  Sort
                           Sort Key: a.id
                           ->  Seq Scan on orexp_a a
               ->  Merge Join
                     Merge Cond: (b_1.y = a_1.id)
                     Join Filter: ((a_1.id = b_1.x) IS NOT TRUE)
                     ->  Sort
                           Sort Key: b_1.y
                           ->  Seq Scan on orexp_b b_1
                     ->  Sort
                           Sort Key: a_1.id
                           ->  Seq Scan on orexp_a a_1
(24 rows)

SELECT a.id, b.x, grouping (a.id), count(*) FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y
GROUP BY GROUPING SETS ((a.id), (b.x), ())
ORDER BY 1, 2, 3, 4;

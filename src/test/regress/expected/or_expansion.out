SELECT g, b.y FROM generate_series(1, (random() * 3)::int) g, orexp_b b
WHERE g = b.x OR g = b.y;
                 QUERY PLAN                  
---------------------------------------------
 Nested Loop
   Join Filter: ((g.g = b.x) OR (g.g = b.y))
   ->  Function Scan on generate_series g
   ->  Materialize
         ->  Seq Scan on orexp_b b
(5 rows)

-- volatile VALUES list
EXPLAIN (COSTS OFF)
SELECT v.a, b.y FROM (VALUES ((random() * 3)::int)) v (a), orexp_b b
WHERE v.a = b.x OR v.a = b.y;
                                QUERY PLAN                                 
---------------------------------------------------------------------------
 Nested Loop
   Join Filter: (("*VALUES*".column1 = b.x) OR ("*VALUES*".column1 = b.y))
   ->  Values Scan on "*VALUES*"
   ->  Seq Scan on orexp_b b
(4 rows)

-- volatile JSON_TABLE expressions
EXPLAIN (COSTS OFF)
SELECT jt.a, b.y FROM json_table(('{"a":' || (random() * 2)::int || '}')::jsonb,
                                 '$' COLUMNS (a int PATH '$.a')) jt, orexp_b b
WHERE jt.a = b.x OR jt.a = b.y;
                  QUERY PLAN                   
-----------------------------------------------
 Nested Loop
   Join Filter: ((jt.a = b.x) OR (jt.a = b.y))
   ->  Table Function Scan on "json_table" jt
   ->  Materialize
         ->  Seq Scan on orexp_b b
(5 rows)

-- volatile function in WHERE
EXPLAIN (COSTS OFF)
SELECT a.id, b.y FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR (a.id = b.y AND random() < 0.5);
                                        QUERY PLAN                                        
------------------------------------------------------------------------------------------
 Nested Loop
   Join Filter: ((a.id = b.x) OR ((a.id = b.y) AND (random() < '0.5'::double precision)))
   ->  Seq Scan on orexp_a a
   ->  Materialize
         ->  Seq Scan on orexp_b b
(5 rows)

-- correlated SubPlan in WHERE
EXPLAIN (COSTS OFF)
SELECT a.id, b.y FROM orexp_a a, orexp_b b
WHERE (a.id = b.x OR a.id = b.y)
  AND a.val > (SELECT max(b2.val) FROM orexp_b b2 WHERE b2.x = a.id);
                    QUERY PLAN                    
--------------------------------------------------
 Nested Loop
   Join Filter: ((a.id = b.x) OR (a.id = b.y))
   ->  Seq Scan on orexp_b b
   ->  Materialize
         ->  Seq Scan on orexp_a a
               Filter: (val > (SubPlan expr_1))
               SubPlan expr_1
                 ->  Aggregate
                       ->  Seq Scan on orexp_b b2
                             Filter: (x = a.id)
(10 rows)

-- TABLESAMPLE
EXPLAIN (COSTS OFF)
SELECT a.id, b.y FROM orexp_a a, orexp_b b TABLESAMPLE SYSTEM (50)
WHERE a.id = b.x OR a.id = b.y;
                  QUERY PLAN                   
-----------------------------------------------
 Nested Loop
   Join Filter: ((a.id = b.x) OR (a.id = b.y))
   ->  Seq Scan on orexp_a a
   ->  Materialize
         ->  Sample Scan on orexp_b b
               Sampling: system ('50'::real)
(6 rows)

-- unreduced FULL JOIN
EXPLAIN (COSTS OFF)
SELECT a.id, b.y FROM orexp_a a FULL JOIN orexp_b b ON a.id = b.x
WHERE a.val IS NULL OR b.val IS NULL;
                   QUERY PLAN                   
------------------------------------------------
 Merge Full Join
   Merge Cond: (b.x = a.id)
   Filter: ((a.val IS NULL) OR (b.val IS NULL))
   ->  Sort
         Sort Key: b.x
         ->  Seq Scan on orexp_b b
   ->  Sort
         Sort Key: a.id
         ->  Seq Scan on orexp_a a
(9 rows)

-- lateral reference
EXPLAIN (COSTS OFF)
SELECT a.id, l.ly FROM orexp_a a,
       LATERAL (SELECT b.y AS ly FROM orexp_b b WHERE b.x = a.id OR b.y = a.val) l
WHERE a.id = l.ly OR a.val = 1;
                                     QUERY PLAN                                     
------------------------------------------------------------------------------------
 Nested Loop
   Join Filter: (((b.x = a.id) OR (b.y = a.val)) AND ((a.id = b.y) OR (a.val = 1)))
   ->  Seq Scan on orexp_a a
   ->  Materialize
         ->  Seq Scan on orexp_b b
(5 rows)

-- unflattened subquery with grouping
EXPLAIN (COSTS OFF)
SELECT a.id, s.n FROM orexp_a a,
       (SELECT x AS sx, count(*) AS n FROM orexp_b GROUP BY x) s
WHERE a.id = s.sx OR a.val = s.n;
                   QUERY PLAN                    
-------------------------------------------------
 Nested Loop
   Join Filter: ((a.id = s.sx) OR (a.val = s.n))
   ->  Seq Scan on orexp_a a
   ->  Materialize
         ->  Subquery Scan on s
               ->  HashAggregate
                     Group Key: orexp_b.x
                     ->  Seq Scan on orexp_b
(8 rows)

-- append relation from UNION ALL
EXPLAIN (COSTS OFF)
SELECT u.id, a.val FROM (SELECT x AS id, val FROM orexp_b
                         UNION ALL
                         SELECT id, val FROM orexp_a) u, orexp_a a
WHERE u.val = a.val OR u.id = a.id;
                             QUERY PLAN                              
---------------------------------------------------------------------
 Gather
   Workers Planned: 2
   ->  Nested Loop
         Join Filter: ((orexp_a.val = a.val) OR (orexp_a.id = a.id))
         ->  Parallel Append
               ->  Parallel Seq Scan on orexp_a
               ->  Parallel Seq Scan on orexp_b
         ->  Materialize
               ->  Seq Scan on orexp_a a
(9 rows)

-- partitioned table
CREATE TABLE orexp_part (id int, d int) PARTITION BY RANGE (d);
CREATE TABLE orexp_part1 PARTITION OF orexp_part FOR VALUES FROM (0) TO (10);
CREATE TABLE orexp_part2 PARTITION OF orexp_part FOR VALUES FROM (10) TO (20);
INSERT INTO orexp_part VALUES (1, 5), (2, 15);
EXPLAIN (COSTS OFF)
SELECT a.id, p.d FROM orexp_a a, orexp_part p
WHERE a.id = p.id OR a.val = p.d;
                       QUERY PLAN                       
--------------------------------------------------------
 Gather
   Workers Planned: 2
   ->  Nested Loop
         Join Filter: ((a.id = p.id) OR (a.val = p.d))
         ->  Parallel Append
               ->  Parallel Seq Scan on orexp_part1 p_1
               ->  Parallel Seq Scan on orexp_part2 p_2
         ->  Materialize
               ->  Seq Scan on orexp_a a
(9 rows)

-- table inheritance
CREATE TABLE orexp_inh_parent (id int, val int);
CREATE TABLE orexp_inh_child () INHERITS (orexp_inh_parent);
INSERT INTO orexp_inh_parent VALUES (1, 10);
INSERT INTO orexp_inh_child VALUES (2, 20);
EXPLAIN (COSTS OFF)
SELECT a.id, p.val FROM orexp_a a, orexp_inh_parent p
WHERE a.id = p.id OR a.val = p.val;
                         QUERY PLAN                          
-------------------------------------------------------------
 Gather
   Workers Planned: 2
   ->  Nested Loop
         Join Filter: ((a.id = p.id) OR (a.val = p.val))
         ->  Parallel Append
               ->  Parallel Seq Scan on orexp_inh_child p_2
               ->  Parallel Seq Scan on orexp_inh_parent p_1
         ->  Materialize
               ->  Seq Scan on orexp_a a
(9 rows)

--
-- Permitted sublinks
--
-- uncorrelated scalar sublink
EXPLAIN (COSTS OFF)
SELECT a.id, b.y FROM orexp_a a, orexp_b b
WHERE (a.id = b.x OR a.id = b.y)
  AND a.val > (SELECT min(val) FROM orexp_b WHERE val > 150)
ORDER BY 1, 2;
                            QUERY PLAN                            
------------------------------------------------------------------
 Sort
   Sort Key: a.id, b.y
   InitPlan expr_1
     ->  Aggregate
           ->  Seq Scan on orexp_b
                 Filter: (val > 150)
   ->  Append
         ->  Merge Join
               Merge Cond: (a.id = b.x)
               ->  Sort
                     Sort Key: a.id
                     ->  Seq Scan on orexp_a a
                           Filter: (val > (InitPlan expr_1).col1)
               ->  Sort
                     Sort Key: b.x
                     ->  Seq Scan on orexp_b b
         ->  Merge Join
               Merge Cond: (a_1.id = b_1.y)
               Join Filter: ((a_1.id = b_1.x) IS NOT TRUE)
               ->  Sort
                     Sort Key: a_1.id
                     ->  Seq Scan on orexp_a a_1
                           Filter: (val > (InitPlan expr_1).col1)
               ->  Sort
                     Sort Key: b_1.y
                     ->  Seq Scan on orexp_b b_1
(26 rows)

SELECT a.id, b.y FROM orexp_a a, orexp_b b
WHERE (a.id = b.x OR a.id = b.y)
  AND a.val > (SELECT min(val) FROM orexp_b WHERE val > 150)
ORDER BY 1, 2;
 id | y 
----+---
(0 rows)

--
-- Multiple OR clauses in WHERE
--
EXPLAIN (COSTS OFF)
SELECT a.id, b.val FROM orexp_a a, orexp_b b
WHERE (a.id = b.x OR a.id = b.y) AND (a.val = b.val OR a.val = b.x)
ORDER BY 1, 2;
                                                 QUERY PLAN                                                 
------------------------------------------------------------------------------------------------------------
 Sort
   Sort Key: a.id, b.val
   ->  Append
         ->  Merge Join
               Merge Cond: (b.x = a.id)
               Join Filter: ((a.val = b.val) OR (a.val = b.x))
               ->  Sort
                     Sort Key: b.x
                     ->  Seq Scan on orexp_b b
               ->  Sort
                     Sort Key: a.id
                     ->  Seq Scan on orexp_a a
         ->  Merge Join
               Merge Cond: (b_1.y = a_1.id)
               Join Filter: (((a_1.id = b_1.x) IS NOT TRUE) AND ((a_1.val = b_1.val) OR (a_1.val = b_1.x)))
               ->  Sort
                     Sort Key: b_1.y
                     ->  Seq Scan on orexp_b b_1
               ->  Sort
                     Sort Key: a_1.id
                     ->  Seq Scan on orexp_a a_1
(21 rows)

SELECT a.id, b.val FROM orexp_a a, orexp_b b
WHERE (a.id = b.x OR a.id = b.y) AND (a.val = b.val OR a.val = b.x)
ORDER BY 1, 2;
 id | val 
----+-----
(0 rows)

--
-- Control via or_expansion_limit
--
-- arm count exceeds limit
SET or_expansion_limit = 2;
EXPLAIN (COSTS OFF)
SELECT a.id, b.y FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y OR a.val = b.val
ORDER BY 1, 2;
                               QUERY PLAN                               
------------------------------------------------------------------------
 Sort
   Sort Key: a.id, b.y
   ->  Nested Loop
         Join Filter: ((a.id = b.x) OR (a.id = b.y) OR (a.val = b.val))
         ->  Seq Scan on orexp_a a
         ->  Materialize
               ->  Seq Scan on orexp_b b
(7 rows)

-- arm count within limit
SET or_expansion_limit = 3;
EXPLAIN (COSTS OFF)
SELECT a.id, b.y FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y OR a.val = b.val
ORDER BY 1, 2;
                                           QUERY PLAN                                           
------------------------------------------------------------------------------------------------
 Sort
   Sort Key: a.id, b.y
   ->  Append
         ->  Merge Join
               Merge Cond: (b.x = a.id)
               ->  Sort
                     Sort Key: b.x
                     ->  Seq Scan on orexp_b b
               ->  Sort
                     Sort Key: a.id
                     ->  Seq Scan on orexp_a a
         ->  Merge Join
               Merge Cond: (b_1.y = a_1.id)
               Join Filter: ((a_1.id = b_1.x) IS NOT TRUE)
               ->  Sort
                     Sort Key: b_1.y
                     ->  Seq Scan on orexp_b b_1
               ->  Sort
                     Sort Key: a_1.id
                     ->  Seq Scan on orexp_a a_1
         ->  Merge Join
               Merge Cond: (b_2.val = a_2.val)
               Join Filter: (((a_2.id = b_2.x) IS NOT TRUE) AND ((a_2.id = b_2.y) IS NOT TRUE))
               ->  Sort
                     Sort Key: b_2.val
                     ->  Seq Scan on orexp_b b_2
               ->  Sort
                     Sort Key: a_2.val
                     ->  Seq Scan on orexp_a a_2
(29 rows)

SELECT a.id, b.y FROM orexp_a a, orexp_b b
WHERE a.id = b.x OR a.id = b.y OR a.val = b.val
ORDER BY 1, 2;
 id | y  
----+----
  1 | 99
  2 |  2
  3 |  3
  4 | 99
(4 rows)

--
-- Clean up
--
RESET or_expansion_limit;
DROP VIEW orexp_v;
DROP TABLE orexp_c, orexp_d;
DROP TABLE orexp_part;
DROP TABLE orexp_inh_parent CASCADE;
NOTICE:  drop cascades to table orexp_inh_child
DROP TABLE orexp_phys, orexp_phys2;
DROP TYPE orexp_c_type;
DROP TABLE orexp_a, orexp_b;

RESET enable_eager_aggregate;
-- Produce results with sorting deduplication
SET enable_hashagg TO off;
EXPLAIN (VERBOSE, COSTS OFF)
SELECT DISTINCT t1.id
  FROM eager_distinct_t1 t1
  JOIN eager_distinct_t2 t2 ON t2.t1_id = t1.id
ORDER BY t1.id;
                           QUERY PLAN                            
-----------------------------------------------------------------
 Sort
   Output: t1.id
   Sort Key: t1.id
   ->  GroupAggregate
         Output: t1.id
         Group Key: t1.id
         ->  Sort
               Output: t1.id
               Sort Key: t1.id
               ->  Nested Loop Semi Join
                     Output: t1.id
                     Join Filter: (t1.id = t2.t1_id)
                     ->  Seq Scan on public.eager_distinct_t1 t1
                           Output: t1.id, t1.val
                     ->  Seq Scan on public.eager_distinct_t2 t2
                           Output: t2.id, t2.t1_id, t2.flag
(16 rows)

SELECT DISTINCT t1.id
  FROM eager_distinct_t1 t1
  JOIN eager_distinct_t2 t2 ON t2.t1_id = t1.id
ORDER BY t1.id;
 id 

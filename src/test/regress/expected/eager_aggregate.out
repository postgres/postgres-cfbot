-----------------------------------------------------------------
 Sort
   Output: t1.id
   Sort Key: t1.id
   ->  HashAggregate
         Output: t1.id
         Group Key: t1.id
         ->  Hash Join
               Output: t1.id
               Hash Cond: (t2.t1_id = t1.id)
               ->  Seq Scan on public.eager_distinct_t2 t2
                     Output: t2.id, t2.t1_id, t2.flag
               ->  Hash
                     Output: t1.id
                     ->  Seq Scan on public.eager_distinct_t1 t1
                           Output: t1.id
(15 rows)


  6
  7
  8
  9
 10
(10 rows)

RESET enable_hashagg;
-- Deduplication is not possible when a column of the to-many side is
-- observable, since its rows are then not interchangeable.
EXPLAIN (VERBOSE, COSTS OFF)
SELECT DISTINCT t1.id, t2.id
  FROM eager_distinct_t1 t1
  JOIN eager_distinct_t2 t2 ON t2.t1_id = t1.id
ORDER BY t1.id, t2.id;
                           QUERY PLAN                            
-----------------------------------------------------------------
 Unique
   Output: t1.id, t2.id
   ->  Sort
         Output: t1.id, t2.id
         Sort Key: t1.id, t2.id
         ->  Hash Join
               Output: t1.id, t2.id
               Hash Cond: (t2.t1_id = t1.id)
               ->  Seq Scan on public.eager_distinct_t2 t2
                     Output: t2.id, t2.t1_id, t2.flag
               ->  Hash
                     Output: t1.id
                     ->  Seq Scan on public.eager_distinct_t1 t1
                           Output: t1.id
(14 rows)

-- Declined for DISTINCT ON too, which keeps a particular row from each
-- group, even though only the driver side is projected here
EXPLAIN (VERBOSE, COSTS OFF)
SELECT DISTINCT ON (t1.id) t1.id
  FROM eager_distinct_t1 t1
  JOIN eager_distinct_t2 t2 ON t2.t1_id = t1.id
ORDER BY t1.id, t2.id;
                           QUERY PLAN                            
-----------------------------------------------------------------
 Unique
   Output: t1.id, t2.id
   ->  Sort
         Output: t1.id, t2.id
         Sort Key: t1.id, t2.id
         ->  Hash Join
               Output: t1.id, t2.id
               Hash Cond: (t2.t1_id = t1.id)
               ->  Seq Scan on public.eager_distinct_t2 t2
                     Output: t2.id, t2.t1_id, t2.flag
               ->  Hash
                     Output: t1.id
                     ->  Seq Scan on public.eager_distinct_t1 t1
                           Output: t1.id
(14 rows)

-- A qual on the to-many side is applied before the deduplication
EXPLAIN (VERBOSE, COSTS OFF)
SELECT DISTINCT t1.id
  FROM eager_distinct_t1 t1
  JOIN eager_distinct_t2 t2 ON t2.t1_id = t1.id
 WHERE t2.flag
ORDER BY t1.id;
                              QUERY PLAN                               
-----------------------------------------------------------------------
 Sort
   Output: t1.id
   Sort Key: t1.id
   ->  HashAggregate
         Output: t1.id
         Group Key: t1.id
         ->  Hash Join
               Output: t1.id
               Hash Cond: (t1.id = t2.t1_id)
               ->  Seq Scan on public.eager_distinct_t1 t1
                     Output: t1.id, t1.val
               ->  Hash
                     Output: t2.t1_id
                     ->  HashAggregate
                           Output: t2.t1_id
                           Group Key: t2.t1_id
                           ->  Seq Scan on public.eager_distinct_t2 t2
                                 Output: t2.id, t2.t1_id, t2.flag
                                 Filter: t2.flag

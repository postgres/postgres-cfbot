    8800 |       0 |               4
    8800 |       0 |               5
    8800 |       0 |               6
    8800 |       0 |               7
(7 rows)

explain (verbose, costs off)
select unique1, unique2, generate_series(1,10)
  from tenk1 order by tenthous limit 7;

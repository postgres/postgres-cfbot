fetch all in c4;
 q1 | q2 
----+----
(0 rows)

declare c5 cursor for select * from int8_tbl order by q1 fetch first 2 rows with ties;
fetch all in c5;
 q1  |        q2        
-----+------------------
 123 |              456
 123 | 4567890123456789
(2 rows)

fetch 1 in c5;
 q1 | q2 
----+----
(0 rows)

fetch backward 1 in c5;

(0 rows)

fetch all in c3;
        q1        |        q2         
------------------+-------------------
 4567890123456789 |  4567890123456789
 4567890123456789 | -4567890123456789
(2 rows)

declare c4 cursor for select * from int8_tbl offset 10;
fetch all in c4;
 q1 | q2 
----+----
(0 rows)


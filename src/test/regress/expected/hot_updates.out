-- Rows updated outside a partial index must not be found through it.
SELECT * FROM update_case(
  $$CREATE TABLE hot_expr_test (id int PRIMARY KEY, status text, v int) WITH (fillfactor = 50);
    CREATE INDEX hot_expr_test_v ON hot_expr_test (v) WHERE status = 'active';
    INSERT INTO hot_expr_test SELECT g, CASE WHEN g <= 5 THEN 'active' ELSE 'done' END, g
      FROM generate_series(1, 10) g$$,
  $$UPDATE hot_expr_test SET v = v + 100 WHERE status = 'done'$$);
 updated | hot 
---------+-----

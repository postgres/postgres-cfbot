      10 |   0
(1 row)

SELECT * FROM update_case(
  $$CREATE TABLE hot_expr_test (id int PRIMARY KEY, status text, v int) WITH (fillfactor = 50);
    CREATE INDEX ON hot_expr_test (v) WHERE status = 'active';
    INSERT INTO hot_expr_test SELECT g, 'done', g FROM generate_series(1, 10) g$$,
  $$UPDATE hot_expr_test SET status = 'archived'$$);
 updated | hot 
---------+-----
      10 |   0
(1 row)

-- Both versions inside the predicate with the key unchanged.
SELECT * FROM update_case(

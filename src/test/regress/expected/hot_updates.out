-- ---------------------------------------------------------------------------
-- Expression and partial indexes
--
-- update_case() runs one UPDATE on a fresh table and reports how many rows
-- it updated, and how many of those with HOT.
-- ---------------------------------------------------------------------------
CREATE FUNCTION update_case(setup text, upd text,
                            OUT updated bigint, OUT hot bigint)
LANGUAGE plpgsql AS $$
BEGIN
    EXECUTE 'DROP TABLE IF EXISTS hot_expr_test';
    EXECUTE setup;
    updated := pg_stat_get_xact_tuples_updated('hot_expr_test'::regclass);
    hot := pg_stat_get_xact_tuples_hot_updated('hot_expr_test'::regclass);
    EXECUTE upd;
    updated := pg_stat_get_xact_tuples_updated('hot_expr_test'::regclass) - updated;
    hot := pg_stat_get_xact_tuples_hot_updated('hot_expr_test'::regclass) - hot;
END;
$$;
-- Expression value unchanged.
SELECT * FROM update_case(
  $$CREATE TABLE hot_expr_test (id int PRIMARY KEY, s text) WITH (fillfactor = 50);
    CREATE INDEX ON hot_expr_test (lower(s));
    INSERT INTO hot_expr_test SELECT g, 'abc' || g FROM generate_series(1, 10) g$$,
  $$UPDATE hot_expr_test SET s = upper(s)$$);
NOTICE:  table "hot_expr_test" does not exist, skipping
 updated | hot 
---------+-----
      10 |   0
(1 row)

SELECT * FROM update_case(
  $$CREATE TABLE hot_expr_test (id int PRIMARY KEY, a int, b int) WITH (fillfactor = 50);
    CREATE INDEX ON hot_expr_test ((a + b));
    INSERT INTO hot_expr_test SELECT g, g, 0 FROM generate_series(1, 10) g$$,
  $$UPDATE hot_expr_test SET a = a - 1, b = b + 1$$);
 updated | hot 
---------+-----
      10 |   0
(1 row)

-- Expression value changed.
SELECT * FROM update_case(
  $$CREATE TABLE hot_expr_test (id int PRIMARY KEY, d jsonb) WITH (fillfactor = 50);
    CREATE INDEX ON hot_expr_test ((d->>'name'));
    INSERT INTO hot_expr_test SELECT g, jsonb_build_object('name', 'n' || g)
      FROM generate_series(1, 10) g$$,
  $$UPDATE hot_expr_test SET d = jsonb_set(d, '{name}', '"x"')$$);
 updated | hot 
---------+-----
      10 |   0
(1 row)

-- Equal values that are stored differently.
SELECT * FROM update_case(
  $$CREATE TABLE hot_expr_test (id int PRIMARY KEY, n numeric) WITH (fillfactor = 50);
    CREATE INDEX ON hot_expr_test ((n + 0));
    INSERT INTO hot_expr_test SELECT g, 3 FROM generate_series(1, 10) g$$,
  $$UPDATE hot_expr_test SET n = 3.0$$);
 updated | hot 
---------+-----
      10 |   0
(1 row)

-- The index stores a type other than the expression's: name_ops stores
-- cstring, and gist point_ops stores box.
SELECT * FROM update_case(
  $$CREATE TABLE hot_expr_test (id int PRIMARY KEY, s text) WITH (fillfactor = 50);
    CREATE INDEX ON hot_expr_test ((lower(s)::name));
    INSERT INTO hot_expr_test SELECT g, 'abc' || g FROM generate_series(1, 10) g$$,
  $$UPDATE hot_expr_test SET s = upper(s)$$);
 updated | hot 
---------+-----
      10 |   0
(1 row)

SELECT * FROM update_case(
  $$CREATE TABLE hot_expr_test (id int PRIMARY KEY, p point) WITH (fillfactor = 50);
    CREATE INDEX ON hot_expr_test USING gist ((point(p[0], 0)));
    INSERT INTO hot_expr_test SELECT g, point(g, g) FROM generate_series(1, 10) g$$,
  $$UPDATE hot_expr_test SET p = point(p[0], p[1] + 1)$$);
 updated | hot 
---------+-----
      10 |   0
(1 row)

-- An expression that is a point, stored by the gist index as a box.
-- Comparing it as the box the index stores rather than as the point it is
-- crashed the server in 2018 (2877.1541538838@sss.pgh.pa.us).
SELECT * FROM update_case(
  $$CREATE TABLE hot_expr_test (id int PRIMARY KEY, d smallint) WITH (fillfactor = 50);
    CREATE INDEX ON hot_expr_test USING gist ((point(d::integer % 7, 0)));
    INSERT INTO hot_expr_test SELECT g, 1 FROM generate_series(1, 10) g$$,
  $$UPDATE hot_expr_test SET d = d + 7$$);
 updated | hot 
---------+-----
      10 |   0
(1 row)

-- A plain index on the same column as an expression index.
SELECT * FROM update_case(
  $$CREATE TABLE hot_expr_test (id int PRIMARY KEY, s text) WITH (fillfactor = 50);
    CREATE INDEX ON hot_expr_test (lower(s));
    CREATE INDEX ON hot_expr_test (s);
    INSERT INTO hot_expr_test SELECT g, 'abc' || g FROM generate_series(1, 10) g$$,
  $$UPDATE hot_expr_test SET s = upper(s)$$);
 updated | hot 
---------+-----
      10 |   0
(1 row)

-- A BRIN index whose column changed, and an expression index whose value
-- did not.
SELECT * FROM update_case(
  $$CREATE TABLE hot_expr_test (id int PRIMARY KEY, s text, b int) WITH (fillfactor = 50);
    CREATE INDEX ON hot_expr_test (lower(s));
    CREATE INDEX ON hot_expr_test USING brin (b);
    INSERT INTO hot_expr_test SELECT g, 'abc' || g, g FROM generate_series(1, 10) g$$,
  $$UPDATE hot_expr_test SET s = upper(s), b = b + 1$$);
 updated | hot 
---------+-----
      10 |   0
(1 row)

-- A BEFORE ROW trigger that changes the expression's value.
CREATE FUNCTION hot_expr_trig() RETURNS trigger LANGUAGE plpgsql AS
  $$BEGIN NEW.s := NEW.s || 'z'; RETURN NEW; END$$;
SELECT * FROM update_case(
  $$CREATE TABLE hot_expr_test (id int PRIMARY KEY, s text, x int) WITH (fillfactor = 50);
    CREATE INDEX ON hot_expr_test (lower(s));
    CREATE TRIGGER t BEFORE UPDATE ON hot_expr_test
      FOR EACH ROW EXECUTE FUNCTION hot_expr_trig();
    INSERT INTO hot_expr_test SELECT g, 'abc' || g, 0 FROM generate_series(1, 10) g$$,
  $$UPDATE hot_expr_test SET x = 1$$);
 updated | hot 
---------+-----
      10 |   0
(1 row)

DROP FUNCTION hot_expr_trig() CASCADE;
NOTICE:  drop cascades to trigger t on table hot_expr_test

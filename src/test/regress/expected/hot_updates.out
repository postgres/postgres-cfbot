    CREATE INDEX ON hot_expr_test (v) WHERE status <> 'x';
    INSERT INTO hot_expr_test SELECT g, 'a', g FROM generate_series(1, 10) g$$,
  $$UPDATE hot_expr_test SET status = 'b'$$);

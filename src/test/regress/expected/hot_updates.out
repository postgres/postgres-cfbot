SELECT pg_stat_force_next_flush();
 pg_stat_force_next_flush 
--------------------------
 
(1 row)

SELECT * FROM get_hot_count('hot_jsonb_test');
 updates | hot 
---------+-----
       2 |   0
(1 row)

UPDATE hot_jsonb_test SET data = jsonb_insert(data, '{country}', '"USA"') WHERE id = 2;
SELECT pg_stat_force_next_flush();
 pg_stat_force_next_flush 
--------------------------
 
(1 row)

SELECT * FROM get_hot_count('hot_jsonb_test');

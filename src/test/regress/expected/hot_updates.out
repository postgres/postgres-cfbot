DROP TABLE hot_expr_test;
-- One UPDATE whose rows each need a different index to decide: some change
-- the expression index, some only enter or leave the partial index created
-- after it, some change neither.  The partial index must hold exactly the
-- rows that satisfy its predicate.
CREATE TABLE hot_expr_multi (id int PRIMARY KEY, doc jsonb) WITH (fillfactor = 30);
CREATE INDEX hot_expr_multi_status ON hot_expr_multi ((doc->>'status'));
CREATE INDEX hot_expr_multi_vip ON hot_expr_multi ((doc->>'email'))
  WHERE (doc->>'vip')::bool;
INSERT INTO hot_expr_multi
  SELECT g, jsonb_build_object('status', 'a', 'email', 'e' || g,
                               'vip', g % 2 = 0, 'n', 0)
    FROM generate_series(1, 300) g;
UPDATE hot_expr_multi SET doc = CASE
    WHEN id % 4 = 0 THEN jsonb_set(doc, '{status}', '"b"')
    WHEN id % 4 = 1 THEN jsonb_set(doc, '{vip}', to_jsonb(NOT (doc->>'vip')::bool))
    WHEN id % 4 = 2 THEN jsonb_set(jsonb_set(doc, '{status}', '"c"'),
                                   '{vip}', to_jsonb(NOT (doc->>'vip')::bool))
    ELSE jsonb_set(doc, '{n}', '1') END;
SET enable_seqscan = off;
SET enable_bitmapscan = off;
SELECT count(*) FROM hot_expr_multi
 WHERE (doc->>'vip')::bool AND doc->>'email' >= 'e';
 count 
-------
   150
(1 row)

RESET enable_seqscan;
RESET enable_bitmapscan;
SELECT count(*) FROM hot_expr_multi WHERE (doc->>'vip')::bool;
 count 
-------
   150
(1 row)

DROP TABLE hot_expr_multi;
-- An index whose concurrent build failed is not ready for inserts, and its
-- expression need not be computable for every row.  An UPDATE must not
-- evaluate it.
CREATE TABLE hot_expr_cic (id int PRIMARY KEY, x int) WITH (fillfactor = 50);
INSERT INTO hot_expr_cic VALUES (1, 1), (2, 0);
CREATE INDEX CONCURRENTLY hot_expr_cic_idx ON hot_expr_cic ((100 / x));
ERROR:  division by zero
SELECT indisready, indisvalid FROM pg_index
 WHERE indexrelid = 'hot_expr_cic_idx'::regclass;
 indisready | indisvalid 
------------+------------
 f          | f
(1 row)

UPDATE hot_expr_cic SET x = 0 WHERE id = 1;
UPDATE hot_expr_cic SET x = 1 WHERE id = 2;
SELECT * FROM hot_expr_cic ORDER BY id;
 id | x 
----+---
  1 | 0
  2 | 1
(2 rows)

DROP TABLE hot_expr_cic;
-- Writing back a value that is stored compressed in the old row, and not
-- yet in the new one.  An SP-GiST index, whose access method cannot compare
-- entries, and which returns the value in index-only scans.
SELECT * FROM update_case(
  $$CREATE TABLE hot_expr_test (id int PRIMARY KEY, t text) WITH (fillfactor = 50);
    CREATE INDEX ON hot_expr_test USING spgist (t);
    INSERT INTO hot_expr_test SELECT g, repeat('x', 3000) || g FROM generate_series(1, 10) g$$,
  $$UPDATE hot_expr_test SET t = repeat('x', 3000) || id$$);
NOTICE:  table "hot_expr_test" does not exist, skipping
 updated | hot 
---------+-----
      10 |   0
(1 row)

SET enable_seqscan = off;
SET enable_bitmapscan = off;
SELECT count(*) FROM hot_expr_test WHERE t = repeat('x', 3000) || 7;
 count 
-------
     1
(1 row)

RESET enable_seqscan;
RESET enable_bitmapscan;
-- The same in a partial index evaluated for another column's change.
SELECT * FROM update_case(
  $$CREATE TABLE hot_expr_test (id int PRIMARY KEY, t text, x int) WITH (fillfactor = 50);
    CREATE INDEX ON hot_expr_test (t) WHERE x >= 0;
    INSERT INTO hot_expr_test SELECT g, repeat('x', 3000) || g, 0 FROM generate_series(1, 10) g$$,
  $$UPDATE hot_expr_test SET t = repeat('x', 3000) || id, x = x + 1$$);
 updated | hot 
---------+-----
      10 |   0
(1 row)

-- The same through an expression that returns the column's value as is.
SELECT * FROM update_case(
  $$CREATE TABLE hot_expr_test (id int PRIMARY KEY, t text, x int) WITH (fillfactor = 50);
    CREATE INDEX ON hot_expr_test ((coalesce(t, ''))) WHERE x >= 0;
    INSERT INTO hot_expr_test SELECT g, repeat('x', 3000) || g, 0 FROM generate_series(1, 10) g$$,
  $$UPDATE hot_expr_test SET t = repeat('x', 3000) || id, x = x + 1$$);
 updated | hot 
---------+-----
      10 |   0
(1 row)

-- ... but not for a column of a unique index, which the table's lock
-- strength is decided by as stored.
SELECT * FROM update_case(
  $$CREATE TABLE hot_expr_test (id int, t text) WITH (fillfactor = 50);
    CREATE UNIQUE INDEX ON hot_expr_test (t);
    INSERT INTO hot_expr_test SELECT g, repeat('x', 3000) || g FROM generate_series(1, 10) g$$,
  $$UPDATE hot_expr_test SET t = repeat('x', 3000) || id$$);
 updated | hot 
---------+-----
      10 |   0
(1 row)

DROP TABLE hot_expr_test;
DROP FUNCTION update_case(text, text);
DROP FUNCTION get_hot_count(text);

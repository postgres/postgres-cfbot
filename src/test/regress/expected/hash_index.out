(1 row)

-- UPDATE hash_ovfl_heap
--    SET x = 1000
--   WHERE x = 90;
-- this vacuums the index as well
-- VACUUM hash_ovfl_heap;
-- SELECT count(*) AS i0 FROM hash_ovfl_heap
--   WHERE x = 90;
-- SELECT count(*) AS i988 FROM hash_ovfl_heap
--  WHERE x = 1000;
--
-- Cause some overflow insert and splits.
--
CREATE TABLE hash_split_heap (keycol INT);
INSERT INTO hash_split_heap SELECT 1 FROM generate_series(1, 500) a;
CREATE INDEX hash_split_index on hash_split_heap USING HASH (keycol);
INSERT INTO hash_split_heap SELECT 1 FROM generate_series(1, 5000) a;
-- Let's do a backward scan.
BEGIN;
SET enable_seqscan = OFF;
SET enable_bitmapscan = OFF;
DECLARE c CURSOR FOR SELECT * from hash_split_heap WHERE keycol = 1;
MOVE FORWARD ALL FROM c;
MOVE BACKWARD 10000 FROM c;
MOVE BACKWARD ALL FROM c;
CLOSE c;
END;
-- DELETE, INSERT, VACUUM.
DELETE FROM hash_split_heap WHERE keycol = 1;
INSERT INTO hash_split_heap SELECT a/2 FROM generate_series(1, 25000) a;
VACUUM hash_split_heap;
-- Rebuild the index using a different fillfactor
ALTER INDEX hash_split_index SET (fillfactor = 10);
REINDEX INDEX hash_split_index;
-- Clean up.
DROP TABLE hash_split_heap;
-- Testcases for removing overflow pages.
CREATE TABLE hash_cleanup_heap(keycol INT);
CREATE INDEX hash_cleanup_index on hash_cleanup_heap USING HASH (keycol);
-- Insert tuples to both the primary bucket page and overflow pages.
INSERT INTO hash_cleanup_heap SELECT 1 FROM generate_series(1, 500) as i;
-- Fill overflow pages by "dead" tuples.
BEGIN;
INSERT INTO hash_cleanup_heap SELECT 1 FROM generate_series(1, 1000) as i;
ROLLBACK;
-- Checkpoint will ensure that all hash buffers are cleaned before we try
-- to remove overflow pages.
CHECKPOINT;
-- This will squeeze the bucket and remove overflow pages.
VACUUM hash_cleanup_heap;
TRUNCATE hash_cleanup_heap;
-- Insert a few tuples so that the primary bucket page doesn't get full and
-- tuples can be moved to it.
INSERT INTO hash_cleanup_heap SELECT 1 FROM generate_series(1, 50) as i;
-- Fill overflow pages by "dead" tuples.
BEGIN;
INSERT INTO hash_cleanup_heap SELECT 1 FROM generate_series(1, 1500) as i;
ROLLBACK;
-- And insert some tuples again. During squeeze operation, these will be moved
-- to the primary bucket allowing to test freeing intermediate overflow pages.
INSERT INTO hash_cleanup_heap SELECT 1 FROM generate_series(1, 500) as i;
CHECKPOINT;
VACUUM hash_cleanup_heap;
TRUNCATE hash_cleanup_heap;
-- Insert tuples to both the primary bucket page and overflow pages.
INSERT INTO hash_cleanup_heap SELECT 1 FROM generate_series(1, 500) as i;
-- Fill overflow pages by "dead" tuples.
BEGIN;
INSERT INTO hash_cleanup_heap SELECT 1 FROM generate_series(1, 1500) as i;
ROLLBACK;
-- And insert some tuples again. During squeeze operation, these will be moved
-- to other overflow pages and also allow overflow pages filled by dead tuples
-- to be freed. Note the main purpose of this test is to test the case where
-- we don't need to move any tuple from the overflow page being freed.
INSERT INTO hash_cleanup_heap SELECT 1 FROM generate_series(1, 50) as i;
CHECKPOINT;
VACUUM hash_cleanup_heap;
-- Test cleanup of dead index tuples on single page with INSERT.
TRUNCATE hash_cleanup_heap;
INSERT INTO hash_cleanup_heap SELECT 1 FROM generate_series(1, 1000) as i;
-- This relies on a rollbacked INSERT instead of a DELETE to make the creation
-- of the dead tuples concurrent-safe.
BEGIN;
INSERT INTO hash_cleanup_heap SELECT 1 FROM generate_series(1, 500) as i;
ROLLBACK;
SET enable_seqscan = off;
SET enable_bitmapscan = off;
SELECT count(*) FROM hash_cleanup_heap WHERE keycol = 1;
 count 
-------
  1000
(1 row)

-- This query checks the hash index pages for dead tuples where the data
-- is inserted, and performs a local VACUUM on a single page.
INSERT INTO hash_cleanup_heap SELECT 1 FROM generate_series(1, 200) as i;
RESET enable_seqscan;
RESET enable_bitmapscan;
-- Clean up.
DROP TABLE hash_cleanup_heap;
-- Index on temp table.
CREATE TEMP TABLE hash_temp_heap (x int, y int);
INSERT INTO hash_temp_heap VALUES (1,1);
CREATE INDEX hash_idx ON hash_temp_heap USING hash (x);
DROP TABLE hash_temp_heap CASCADE;
-- Float4 type.
CREATE TABLE hash_heap_float4 (x float4, y int);
INSERT INTO hash_heap_float4 VALUES (1.1,1);
CREATE INDEX hash_idx ON hash_heap_float4 USING hash (x);
DROP TABLE hash_heap_float4 CASCADE;
-- Test out-of-range fillfactor values
CREATE INDEX hash_f8_index2 ON hash_f8_heap USING hash (random float8_ops)
	WITH (fillfactor=9);
ERROR:  value 9 out of bounds for option "fillfactor"
DETAIL:  Valid values are between "10" and "100".
CREATE INDEX hash_f8_index2 ON hash_f8_heap USING hash (random float8_ops)
	WITH (fillfactor=101);
ERROR:  value 101 out of bounds for option "fillfactor"
DETAIL:  Valid values are between "10" and "100".
--
-- An UPDATE to a value with the same hash code is HOT: the index stores
-- only the code, and scans recheck the heap tuple.
--
CREATE TABLE hash_hot (id int, n numeric) WITH (fillfactor = 10);
CREATE INDEX hash_hot_n ON hash_hot USING hash (n);
CREATE INDEX hash_hot_n2 ON hash_hot USING hash ((n * 2));
INSERT INTO hash_hot SELECT g, g FROM generate_series(1, 50) g;
-- (pg_stat_get_xact_* count this transaction's updates, and earlier
-- transactions' not yet reported)
CREATE FUNCTION hash_hot_count(OUT updated bigint, OUT hot bigint)
LANGUAGE sql AS $$
  SELECT pg_stat_get_xact_tuples_updated('hash_hot'::regclass),
         pg_stat_get_xact_tuples_hot_updated('hash_hot'::regclass) $$;
BEGIN;
-- numeric hashes ignore the display scale, in the column and in the
-- expression: HOT
UPDATE hash_hot SET n = n + 0.00;
SELECT * FROM hash_hot_count();
 updated | hot 
---------+-----
      50 |  50
(1 row)

-- a different value: not HOT
UPDATE hash_hot SET n = n + 100 WHERE id <= 5;
SELECT * FROM hash_hot_count();
 updated | hot 
---------+-----
      55 |  50
(1 row)

COMMIT;
SET enable_seqscan = off;
SET enable_bitmapscan = off;
EXPLAIN (COSTS OFF) SELECT id, n FROM hash_hot WHERE n = 7;
               QUERY PLAN                
-----------------------------------------
 Index Scan using hash_hot_n on hash_hot
   Index Cond: (n = '7'::numeric)
(2 rows)

SELECT id, n FROM hash_hot WHERE n = 7;
 id |  n   
----+------
  7 | 7.00
(1 row)

SELECT id, n FROM hash_hot WHERE n = 7.000;
 id |  n   
----+------
  7 | 7.00
(1 row)

SELECT id, n FROM hash_hot WHERE n = 3;
 id | n 
----+---
(0 rows)

SELECT id, n FROM hash_hot WHERE n = 103;
 id |   n    
----+--------
  3 | 103.00
(1 row)

SELECT id, n FROM hash_hot WHERE n * 2 = 14;
 id |  n   
----+------
  7 | 7.00
(1 row)

RESET enable_bitmapscan;
SET enable_indexscan = off;
SELECT count(*) FROM hash_hot h WHERE n = (SELECT n FROM hash_hot WHERE id = h.id);
 count 
-------
    50
(1 row)

RESET enable_indexscan;
RESET enable_seqscan;
DROP TABLE hash_hot;
-- text's equality implies image equality, so a value that changes needs a
-- new entry; the index is not asked to hash the two
CREATE TABLE hash_hot (id int, t text) WITH (fillfactor = 10);
CREATE INDEX hash_hot_t ON hash_hot USING hash (t);
INSERT INTO hash_hot SELECT g, 'v' || g FROM generate_series(1, 50) g;
SELECT pg_stat_force_next_flush();
 pg_stat_force_next_flush 
--------------------------
 
(1 row)

BEGIN;
UPDATE hash_hot SET t = t || 'x' WHERE id <= 5;
SELECT * FROM hash_hot_count();
 updated | hot 
---------+-----
       5 |   0
(1 row)

COMMIT;
SET enable_seqscan = off;
SET enable_bitmapscan = off;
SELECT id, t FROM hash_hot WHERE t = 'v3x';
 id |  t  
----+-----
  3 | v3x
(1 row)

SELECT id, t FROM hash_hot WHERE t = 'v3';
 id | t 
----+---
(0 rows)

RESET enable_bitmapscan;
RESET enable_seqscan;
DROP TABLE hash_hot;
-- An exclusion constraint is checked on the values, so a change to a value
-- with the same hash code must still make a new entry and be checked.
-- An interval hashes as hashint8() of its span in microseconds, which folds
-- the high half into the low, so 1 and 2^32 microseconds collide.  (int8
-- would not do: its equality implies image equality, so the index is not
-- asked about two different int8 values at all.)
SELECT interval_hash('00:00:00.000001') = interval_hash('01:11:34.967296') AS same_hash;
 same_hash 
-----------
 t
(1 row)

CREATE TABLE hash_hot (id int, k interval, EXCLUDE USING hash (k WITH =))
  WITH (fillfactor = 10);
INSERT INTO hash_hot VALUES (1, '00:00:00.000001'), (2, '01:11:34.967296');
UPDATE hash_hot SET k = '01:11:34.967296' WHERE id = 1;
ERROR:  conflicting key value violates exclusion constraint "hash_hot_k_excl"
DETAIL:  Key (k)=(@ 1 hour 11 mins 34.967296 secs) conflicts with existing key (k)=(@ 1 hour 11 mins 34.967296 secs).
-- pg_stat_get_xact_* also count earlier transactions' updates not yet
-- reported; report them, so the counts below start from zero
SELECT pg_stat_force_next_flush();
 pg_stat_force_next_flush 
--------------------------
 
(1 row)

BEGIN;
DELETE FROM hash_hot WHERE id = 2;
-- without a conflict, the update is checked and is not HOT
UPDATE hash_hot SET k = '01:11:34.967296' WHERE id = 1;
SELECT * FROM hash_hot_count();
 updated | hot 
---------+-----
       1 |   0
(1 row)

COMMIT;
SELECT * FROM hash_hot;
 id |                k                
----+---------------------------------
  1 | @ 1 hour 11 mins 34.967296 secs
(1 row)

DROP TABLE hash_hot;
DROP FUNCTION hash_hot_count;

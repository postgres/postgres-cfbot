SELECT c.relname,
       t.relfilenode = c.relfilenode,
       t.reltablespace = c.reltablespace
  FROM pg_gtrs_in_use() t LEFT JOIN pg_class c ON c.oid = t.oid
 WHERE c.relname ~ 'tmp1' OR c.relname ~ 'tmp2'
 ORDER BY c.relname;
   relname    | ?column? | ?column? 
--------------+----------+----------
 tmp1         | t        | t
 tmp1_pkey    | t        | t
 tmp2         | t        | t
 tmp2_p1      | t        | t

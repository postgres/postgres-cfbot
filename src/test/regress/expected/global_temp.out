-- Re-check pg_gtrs_in_use()
SELECT c.relname,
       t.relfilenode = c.relfilenode,
       t.reltablespace = c.reltablespace
  FROM pg_gtrs_in_use() t LEFT JOIN pg_class c ON c.oid = t.oid
 WHERE c.relname !~ 'pg_toast_'
 ORDER BY c.relname;

--------------------+--------------------
 200|70100 idx 50/0 | 200|70100 idx 50/0
(1 row)

CALL ad_setup(false);
NOTICE:  table "ad_h" does not exist, skipping
NOTICE:  table "ad_f" does not exist, skipping
BEGIN; CALL ad_upd(); CALL ad_ddl('DROP INDEX %1$I_k'); ROLLBACK AND CHAIN;
CALL ad_upd(); COMMIT; SELECT * FROM ad_check();
        heap        |        flux        
--------------------+--------------------
 200|70100 idx 50/0 | 200|70100 idx 50/0
(1 row)

CALL ad_setup(true);

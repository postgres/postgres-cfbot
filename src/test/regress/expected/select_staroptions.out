--
-- SELECT EXCLUDE/REPLACE/RENAME
--
SET client_min_messages TO 'warning';
DROP TABLE IF EXISTS users;
DROP TABLE IF EXISTS orders;
RESET client_min_messages;
CREATE TABLE users (
    id          INT PRIMARY KEY,
    name        TEXT,
    email       TEXT,
    created_at  TIMESTAMP
);
CREATE TABLE orders (
    id          INT PRIMARY KEY,
    user_id     INT REFERENCES users(id),
    amount      NUMERIC(10,2),
    status      TEXT
);
CREATE SCHEMA s1;
CREATE SCHEMA s2;
CREATE TABLE s1.products (
    id          INT PRIMARY KEY,
    name        TEXT,
    price       NUMERIC(10,2)
);
CREATE TABLE s2.products (
    id          INT PRIMARY KEY,
    name        TEXT,
    price       NUMERIC(10,2),
    description TEXT
);
-- Insert sample data
INSERT INTO users (id, name, email, created_at) VALUES
(1, 'Alice', 'alice@example.com', '2026-01-01 10:00:00'),
(2, 'Bob', 'bob@example.com', '2026-01-02 11:00:00'),
(3, 'Carol', NULL, '2026-01-03 12:00:00');
INSERT INTO orders (id, user_id, amount, status) VALUES
(101, 1, 50.00, 'paid'),
(102, 1, 75.50, 'shipped'),
(103, 2, 20.00, 'cancelled');
INSERT INTO s1.products (id, name, price) VALUES
(1, 'Product A', 10.00),
(2, 'Product B', 15.50);
INSERT INTO s2.products (id, name, price, description) VALUES
(1, 'Product X', 20.00, 'Description for X'),
(2, 'Product Y', 25.75, 'Description for Y');
--
-- EXCLUDE clause
--
-- Simple EXCLUDE
SELECT * (EXCLUDE (email, created_at))
FROM users
ORDER BY id;
 id | name  
----+-------
  1 | Alice
  2 | Bob
  3 | Carol
(3 rows)

-- Exclude all but one column
SELECT * (EXCLUDE (name, email, created_at))
FROM users
ORDER BY id;
 id 
----
  1
  2
  3
(3 rows)

-- Exclude all columns
SELECT * (EXCLUDE (id, name, email, created_at))
FROM users;
--
(3 rows)

-- EXCLUDE all using exclude list but overall SELECT list is not empty
SELECT id, users.* (EXCLUDE (id, name, email, created_at))
FROM users
ORDER BY id;
 id 
----
  1
  2
  3
(3 rows)

-- Aliasing with EXCLUDE
SELECT * (EXCLUDE (u.email))
FROM users AS u
ORDER BY u.id;
 id | name  |        created_at        
----+-------+--------------------------
  1 | Alice | Thu Jan 01 10:00:00 2026
  2 | Bob   | Fri Jan 02 11:00:00 2026
  3 | Carol | Sat Jan 03 12:00:00 2026
(3 rows)

-- Expressions with EXCLUDE
SELECT * (EXCLUDE (name)), 1 + 1 AS two
FROM users
ORDER BY id;
 id |       email       |        created_at        | two 
----+-------------------+--------------------------+-----
  1 | alice@example.com | Thu Jan 01 10:00:00 2026 |   2
  2 | bob@example.com   | Fri Jan 02 11:00:00 2026 |   2
  3 |                   | Sat Jan 03 12:00:00 2026 |   2
(3 rows)

-- JOINs with EXCLUDE
-- Join, unqualified EXCLUDE
SELECT * (EXCLUDE (created_at))
FROM users
JOIN orders ON orders.user_id = users.id
ORDER BY users.id, orders.id;
 id | name  |       email       | id  | user_id | amount |  status   
----+-------+-------------------+-----+---------+--------+-----------
  1 | Alice | alice@example.com | 101 |       1 |  50.00 | paid
  1 | Alice | alice@example.com | 102 |       1 |  75.50 | shipped
  2 | Bob   | bob@example.com   | 103 |       2 |  20.00 | cancelled
(3 rows)

-- Join, qualified EXCLUDE
SELECT * (EXCLUDE (users.created_at, orders.amount))
FROM users
JOIN orders ON orders.user_id = users.id
ORDER BY users.id, orders.id;
 id | name  |       email       | id  | user_id |  status   
----+-------+-------------------+-----+---------+-----------
  1 | Alice | alice@example.com | 101 |       1 | paid
  1 | Alice | alice@example.com | 102 |       1 | shipped
  2 | Bob   | bob@example.com   | 103 |       2 | cancelled
(3 rows)

-- Join, aliased tables with EXCLUDE
SELECT * (EXCLUDE (u.created_at, o.amount))
FROM users AS u
JOIN orders AS o ON o.user_id = u.id
ORDER BY u.id, o.id;
 id | name  |       email       | id  | user_id |  status   
----+-------+-------------------+-----+---------+-----------
  1 | Alice | alice@example.com | 101 |       1 | paid
  1 | Alice | alice@example.com | 102 |       1 | shipped
  2 | Bob   | bob@example.com   | 103 |       2 | cancelled
(3 rows)

-- Qualified stars; EXCLUDE is applied to each star separately
SELECT
users.* (EXCLUDE (id)),
orders.* (EXCLUDE (user_id))
FROM users
LEFT JOIN orders ON orders.user_id = users.id
ORDER BY users.id, orders.id;
 name  |       email       |        created_at        | id  | amount |  status   
-------+-------------------+--------------------------+-----+--------+-----------
 Alice | alice@example.com | Thu Jan 01 10:00:00 2026 | 101 |  50.00 | paid
 Alice | alice@example.com | Thu Jan 01 10:00:00 2026 | 102 |  75.50 | shipped
 Bob   | bob@example.com   | Fri Jan 02 11:00:00 2026 | 103 |  20.00 | cancelled
 Carol |                   | Sat Jan 03 12:00:00 2026 |     |        | 
(4 rows)

-- Schema-qualified star
SELECT s1.products.* (EXCLUDE (price))
FROM s1.products
ORDER BY id;
 id |   name    
----+-----------
  1 | Product A
  2 | Product B
(2 rows)

-- Schema-qualified column
SELECT * (EXCLUDE (s1.products.price))
FROM s1.products
ORDER BY id;
 id |   name    
----+-----------
  1 | Product A
  2 | Product B
(2 rows)

-- Name collision
SELECT * (EXCLUDE (id))
FROM users
JOIN orders ON orders.user_id = users.id
ORDER BY users.id, orders.id;
 name  |       email       |        created_at        | user_id | amount |  status   
-------+-------------------+--------------------------+---------+--------+-----------
 Alice | alice@example.com | Thu Jan 01 10:00:00 2026 |       1 |  50.00 | paid
 Alice | alice@example.com | Thu Jan 01 10:00:00 2026 |       1 |  75.50 | shipped
 Bob   | bob@example.com   | Fri Jan 02 11:00:00 2026 |       2 |  20.00 | cancelled
(3 rows)

-- Subqueries with EXCLUDE
SELECT * (EXCLUDE (u.created_at))
FROM (
    SELECT * FROM users
) u
ORDER BY id;
 id | name  |       email       
----+-------+-------------------
  1 | Alice | alice@example.com
  2 | Bob   | bob@example.com
  3 | Carol | 
(3 rows)

SELECT * (EXCLUDE (j.created_at))
FROM (
    users JOIN orders USING (id)
) AS j;
 id | name | email | user_id | amount | status 
----+------+-------+---------+--------+--------
(0 rows)

-- CTEs with EXCLUDE
WITH base_users AS (
    SELECT * FROM users
)
SELECT * (EXCLUDE (base_users.created_at))
FROM base_users
ORDER BY id;
 id | name  |       email       
----+-------+-------------------
  1 | Alice | alice@example.com
  2 | Bob   | bob@example.com
  3 | Carol | 
(3 rows)

-- Multiple FROM items with EXCLUDE
SELECT * (EXCLUDE (email, status)) FROM users, orders ORDER BY users.id, orders.id;
 id | name  |        created_at        | id  | user_id | amount 
----+-------+--------------------------+-----+---------+--------
  1 | Alice | Thu Jan 01 10:00:00 2026 | 101 |       1 |  50.00
  1 | Alice | Thu Jan 01 10:00:00 2026 | 102 |       1 |  75.50
  1 | Alice | Thu Jan 01 10:00:00 2026 | 103 |       2 |  20.00
  2 | Bob   | Fri Jan 02 11:00:00 2026 | 101 |       1 |  50.00
  2 | Bob   | Fri Jan 02 11:00:00 2026 | 102 |       1 |  75.50
  2 | Bob   | Fri Jan 02 11:00:00 2026 | 103 |       2 |  20.00
  3 | Carol | Sat Jan 03 12:00:00 2026 | 101 |       1 |  50.00
  3 | Carol | Sat Jan 03 12:00:00 2026 | 102 |       1 |  75.50
  3 | Carol | Sat Jan 03 12:00:00 2026 | 103 |       2 |  20.00
(9 rows)

-- CROSS JOIN with EXCLUDE
SELECT * (EXCLUDE (email, status)) FROM users CROSS JOIN orders ORDER BY users.id, orders.id;
 id | name  |        created_at        | id  | user_id | amount 
----+-------+--------------------------+-----+---------+--------
  1 | Alice | Thu Jan 01 10:00:00 2026 | 101 |       1 |  50.00
  1 | Alice | Thu Jan 01 10:00:00 2026 | 102 |       1 |  75.50
  1 | Alice | Thu Jan 01 10:00:00 2026 | 103 |       2 |  20.00
  2 | Bob   | Fri Jan 02 11:00:00 2026 | 101 |       1 |  50.00
  2 | Bob   | Fri Jan 02 11:00:00 2026 | 102 |       1 |  75.50
  2 | Bob   | Fri Jan 02 11:00:00 2026 | 103 |       2 |  20.00
  3 | Carol | Sat Jan 03 12:00:00 2026 | 101 |       1 |  50.00
  3 | Carol | Sat Jan 03 12:00:00 2026 | 102 |       1 |  75.50
  3 | Carol | Sat Jan 03 12:00:00 2026 | 103 |       2 |  20.00
(9 rows)

--
-- REPLACE clause
--
-- Simple REPLACE
SELECT * (REPLACE (email WITH 'user@example.com', created_at WITH NULL))
FROM users
ORDER BY id;
 id | name  |      email       | created_at 
----+-------+------------------+------------
  1 | Alice | user@example.com | 
  2 | Bob   | user@example.com | 
  3 | Carol | user@example.com | 
(3 rows)

-- Aliasing with REPLACE
SELECT * (REPLACE (u.email WITH 'user@example.com'))
FROM users AS u
ORDER BY u.id;
 id | name  |      email       |        created_at        
----+-------+------------------+--------------------------
  1 | Alice | user@example.com | Thu Jan 01 10:00:00 2026
  2 | Bob   | user@example.com | Fri Jan 02 11:00:00 2026
  3 | Carol | user@example.com | Sat Jan 03 12:00:00 2026
(3 rows)

-- Expressions with REPLACE
SELECT * (REPLACE (created_at WITH NULL)), 1 + 1 AS two
FROM users
ORDER BY id;
 id | name  |       email       | created_at | two 
----+-------+-------------------+------------+-----
  1 | Alice | alice@example.com |            |   2
  2 | Bob   | bob@example.com   |            |   2
  3 | Carol |                   |            |   2
(3 rows)

-- JOINs with REPLACE
-- Join, unqualified REPLACE
SELECT * (REPLACE (created_at WITH created_at + INTERVAL '1 day'))
FROM users
JOIN orders ON orders.user_id = users.id
ORDER BY users.id, orders.id;
 id | name  |       email       |        created_at        | id  | user_id | amount |  status   
----+-------+-------------------+--------------------------+-----+---------+--------+-----------
  1 | Alice | alice@example.com | Fri Jan 02 10:00:00 2026 | 101 |       1 |  50.00 | paid
  1 | Alice | alice@example.com | Fri Jan 02 10:00:00 2026 | 102 |       1 |  75.50 | shipped
  2 | Bob   | bob@example.com   | Sat Jan 03 11:00:00 2026 | 103 |       2 |  20.00 | cancelled
(3 rows)

-- Join, qualified REPLACE
SELECT * (REPLACE (users.created_at WITH NULL, orders.amount WITH orders.amount * 2))
FROM users
JOIN orders ON orders.user_id = users.id
ORDER BY users.id, orders.id;
 id | name  |       email       | created_at | id  | user_id | amount |  status   
----+-------+-------------------+------------+-----+---------+--------+-----------
  1 | Alice | alice@example.com |            | 101 |       1 | 100.00 | paid
  1 | Alice | alice@example.com |            | 102 |       1 | 151.00 | shipped
  2 | Bob   | bob@example.com   |            | 103 |       2 |  40.00 | cancelled
(3 rows)

-- Join, aliased tables with REPLACE
SELECT * (REPLACE (u.created_at WITH NULL, o.amount WITH o.amount * 2))
FROM users AS u
JOIN orders AS o ON o.user_id = u.id
ORDER BY u.id, o.id;
 id | name  |       email       | created_at | id  | user_id | amount |  status   
----+-------+-------------------+------------+-----+---------+--------+-----------
  1 | Alice | alice@example.com |            | 101 |       1 | 100.00 | paid
  1 | Alice | alice@example.com |            | 102 |       1 | 151.00 | shipped
  2 | Bob   | bob@example.com   |            | 103 |       2 |  40.00 | cancelled
(3 rows)

-- Qualified stars; REPLACE is applied to each star separately
SELECT
users.* (REPLACE (id WITH 999)),
orders.* (REPLACE (user_id WITH NULL))
FROM users
LEFT JOIN orders ON orders.user_id = users.id
ORDER BY users.id, orders.id;
 id  | name  |       email       |        created_at        | id  | user_id | amount |  status   
-----+-------+-------------------+--------------------------+-----+---------+--------+-----------
 999 | Alice | alice@example.com | Thu Jan 01 10:00:00 2026 | 101 |         |  50.00 | paid
 999 | Alice | alice@example.com | Thu Jan 01 10:00:00 2026 | 102 |         |  75.50 | shipped
 999 | Bob   | bob@example.com   | Fri Jan 02 11:00:00 2026 | 103 |         |  20.00 | cancelled
 999 | Carol |                   | Sat Jan 03 12:00:00 2026 |     |         |        | 
(4 rows)

-- Schema-qualified star
SELECT s1.products.* (REPLACE (price WITH price * 1.1))
FROM s1.products
ORDER BY id;
 id |   name    | price  
----+-----------+--------
  1 | Product A | 11.000
  2 | Product B | 17.050
(2 rows)

-- Schema-qualified column
SELECT * (REPLACE (s1.products.price WITH s1.products.price * 1.1))
FROM s1.products
ORDER BY id;
 id |   name    | price  
----+-----------+--------
  1 | Product A | 11.000
  2 | Product B | 17.050
(2 rows)

-- Name collision
SELECT * (REPLACE (id WITH 999))
FROM users
JOIN orders ON orders.user_id = users.id
ORDER BY users.id, orders.id;
 id  | name  |       email       |        created_at        | id  | user_id | amount |  status   
-----+-------+-------------------+--------------------------+-----+---------+--------+-----------
 999 | Alice | alice@example.com | Thu Jan 01 10:00:00 2026 | 999 |       1 |  50.00 | paid
 999 | Alice | alice@example.com | Thu Jan 01 10:00:00 2026 | 999 |       1 |  75.50 | shipped
 999 | Bob   | bob@example.com   | Fri Jan 02 11:00:00 2026 | 999 |       2 |  20.00 | cancelled
(3 rows)

-- Subqueries with REPLACE
SELECT * (REPLACE (u.created_at WITH u.created_at + INTERVAL '1 day'))
FROM (
    SELECT * FROM users
) u
ORDER BY id;
 id | name  |       email       |        created_at        
----+-------+-------------------+--------------------------
  1 | Alice | alice@example.com | Fri Jan 02 10:00:00 2026
  2 | Bob   | bob@example.com   | Sat Jan 03 11:00:00 2026
  3 | Carol |                   | Sun Jan 04 12:00:00 2026
(3 rows)

SELECT * (REPLACE (j.created_at WITH j.created_at + INTERVAL '1 day'))
FROM (
    users JOIN orders USING (id)
) AS j;
 id | name | email | created_at | user_id | amount | status 
----+------+-------+------------+---------+--------+--------
(0 rows)

-- CTEs with REPLACE
WITH base_users AS (
    SELECT * FROM users
)
SELECT * (REPLACE (base_users.created_at WITH NULL))
FROM base_users
ORDER BY id;
 id | name  |       email       | created_at 
----+-------+-------------------+------------
  1 | Alice | alice@example.com | 
  2 | Bob   | bob@example.com   | 
  3 | Carol |                   | 
(3 rows)

-- Multiple FROM items with REPLACE
SELECT * (REPLACE (email WITH 'user@example.com', status WITH 'N/A')) FROM users, orders ORDER BY users.id, orders.id;
 id | name  |      email       |        created_at        | id  | user_id | amount | status 
----+-------+------------------+--------------------------+-----+---------+--------+--------
  1 | Alice | user@example.com | Thu Jan 01 10:00:00 2026 | 101 |       1 |  50.00 | N/A
  1 | Alice | user@example.com | Thu Jan 01 10:00:00 2026 | 102 |       1 |  75.50 | N/A
  1 | Alice | user@example.com | Thu Jan 01 10:00:00 2026 | 103 |       2 |  20.00 | N/A
  2 | Bob   | user@example.com | Fri Jan 02 11:00:00 2026 | 101 |       1 |  50.00 | N/A
  2 | Bob   | user@example.com | Fri Jan 02 11:00:00 2026 | 102 |       1 |  75.50 | N/A
  2 | Bob   | user@example.com | Fri Jan 02 11:00:00 2026 | 103 |       2 |  20.00 | N/A
  3 | Carol | user@example.com | Sat Jan 03 12:00:00 2026 | 101 |       1 |  50.00 | N/A
  3 | Carol | user@example.com | Sat Jan 03 12:00:00 2026 | 102 |       1 |  75.50 | N/A
  3 | Carol | user@example.com | Sat Jan 03 12:00:00 2026 | 103 |       2 |  20.00 | N/A
(9 rows)

-- CROSS JOIN with REPLACE
SELECT * (REPLACE (email WITH 'user@example.com', status WITH 'N/A')) FROM users CROSS JOIN orders ORDER BY users.id, orders.id;
 id | name  |      email       |        created_at        | id  | user_id | amount | status 
----+-------+------------------+--------------------------+-----+---------+--------+--------
  1 | Alice | user@example.com | Thu Jan 01 10:00:00 2026 | 101 |       1 |  50.00 | N/A
  1 | Alice | user@example.com | Thu Jan 01 10:00:00 2026 | 102 |       1 |  75.50 | N/A
  1 | Alice | user@example.com | Thu Jan 01 10:00:00 2026 | 103 |       2 |  20.00 | N/A
  2 | Bob   | user@example.com | Fri Jan 02 11:00:00 2026 | 101 |       1 |  50.00 | N/A
  2 | Bob   | user@example.com | Fri Jan 02 11:00:00 2026 | 102 |       1 |  75.50 | N/A
  2 | Bob   | user@example.com | Fri Jan 02 11:00:00 2026 | 103 |       2 |  20.00 | N/A
  3 | Carol | user@example.com | Sat Jan 03 12:00:00 2026 | 101 |       1 |  50.00 | N/A
  3 | Carol | user@example.com | Sat Jan 03 12:00:00 2026 | 102 |       1 |  75.50 | N/A
  3 | Carol | user@example.com | Sat Jan 03 12:00:00 2026 | 103 |       2 |  20.00 | N/A
(9 rows)

--
-- RENAME clause
--
-- Simple RENAME
SELECT * (RENAME (name AS user_name, email AS user_email))
FROM users
ORDER BY id;
 id | user_name |    user_email     |        created_at        
----+-----------+-------------------+--------------------------
  1 | Alice     | alice@example.com | Thu Jan 01 10:00:00 2026
  2 | Bob       | bob@example.com   | Fri Jan 02 11:00:00 2026
  3 | Carol     |                   | Sat Jan 03 12:00:00 2026
(3 rows)

-- Aliasing with RENAME
SELECT * (RENAME (u.email AS user_email))
FROM users AS u
ORDER BY u.id;
 id | name  |    user_email     |        created_at        
----+-------+-------------------+--------------------------
  1 | Alice | alice@example.com | Thu Jan 01 10:00:00 2026
  2 | Bob   | bob@example.com   | Fri Jan 02 11:00:00 2026
  3 | Carol |                   | Sat Jan 03 12:00:00 2026
(3 rows)

-- Expressions with RENAME
SELECT * (RENAME (created_at AS date_created)), 1 + 1 AS two
FROM users
ORDER BY id;
 id | name  |       email       |       date_created       | two 
----+-------+-------------------+--------------------------+-----
  1 | Alice | alice@example.com | Thu Jan 01 10:00:00 2026 |   2
  2 | Bob   | bob@example.com   | Fri Jan 02 11:00:00 2026 |   2
  3 | Carol |                   | Sat Jan 03 12:00:00 2026 |   2
(3 rows)

-- JOINs with RENAME
-- Join, unqualified RENAME
SELECT * (RENAME (created_at AS date_created))
FROM users
JOIN orders ON orders.user_id = users.id
ORDER BY users.id, orders.id;
 id | name  |       email       |       date_created       | id  | user_id | amount |  status   
----+-------+-------------------+--------------------------+-----+---------+--------+-----------
  1 | Alice | alice@example.com | Thu Jan 01 10:00:00 2026 | 101 |       1 |  50.00 | paid
  1 | Alice | alice@example.com | Thu Jan 01 10:00:00 2026 | 102 |       1 |  75.50 | shipped
  2 | Bob   | bob@example.com   | Fri Jan 02 11:00:00 2026 | 103 |       2 |  20.00 | cancelled
(3 rows)

-- Join, qualified RENAME
SELECT * (RENAME (users.created_at AS date_created, orders.amount AS order_amount))
FROM users
JOIN orders ON orders.user_id = users.id
ORDER BY users.id, orders.id;
 id | name  |       email       |       date_created       | id  | user_id | order_amount |  status   
----+-------+-------------------+--------------------------+-----+---------+--------------+-----------
  1 | Alice | alice@example.com | Thu Jan 01 10:00:00 2026 | 101 |       1 |        50.00 | paid
  1 | Alice | alice@example.com | Thu Jan 01 10:00:00 2026 | 102 |       1 |        75.50 | shipped
  2 | Bob   | bob@example.com   | Fri Jan 02 11:00:00 2026 | 103 |       2 |        20.00 | cancelled
(3 rows)

-- Join, aliased tables with RENAME
SELECT * (RENAME (u.created_at AS date_created, o.amount AS order_amount))
FROM users AS u
JOIN orders AS o ON o.user_id = u.id
ORDER BY u.id, o.id;
 id | name  |       email       |       date_created       | id  | user_id | order_amount |  status   
----+-------+-------------------+--------------------------+-----+---------+--------------+-----------
  1 | Alice | alice@example.com | Thu Jan 01 10:00:00 2026 | 101 |       1 |        50.00 | paid
  1 | Alice | alice@example.com | Thu Jan 01 10:00:00 2026 | 102 |       1 |        75.50 | shipped
  2 | Bob   | bob@example.com   | Fri Jan 02 11:00:00 2026 | 103 |       2 |        20.00 | cancelled
(3 rows)

-- Qualified stars; RENAME is applied to each star separately
SELECT
users.* (RENAME (id AS uid)),
orders.* (RENAME (user_id AS customer_id))
FROM users
LEFT JOIN orders ON orders.user_id = users.id
ORDER BY users.id, orders.id;
 uid | name  |       email       |        created_at        | id  | customer_id | amount |  status   
-----+-------+-------------------+--------------------------+-----+-------------+--------+-----------
   1 | Alice | alice@example.com | Thu Jan 01 10:00:00 2026 | 101 |           1 |  50.00 | paid
   1 | Alice | alice@example.com | Thu Jan 01 10:00:00 2026 | 102 |           1 |  75.50 | shipped
   2 | Bob   | bob@example.com   | Fri Jan 02 11:00:00 2026 | 103 |           2 |  20.00 | cancelled
   3 | Carol |                   | Sat Jan 03 12:00:00 2026 |     |             |        | 
(4 rows)

-- Schema-qualified star
SELECT s1.products.* (RENAME (price AS product_price))
FROM s1.products
ORDER BY id;
 id |   name    | product_price 
----+-----------+---------------
  1 | Product A |         10.00
  2 | Product B |         15.50
(2 rows)

-- Schema-qualified column
SELECT * (RENAME (s1.products.price AS product_price))
FROM s1.products
ORDER BY id;
 id |   name    | product_price 
----+-----------+---------------
  1 | Product A |         10.00
  2 | Product B |         15.50
(2 rows)

-- Name collision
SELECT * (RENAME (id AS _id))
FROM users
JOIN orders ON orders.user_id = users.id
ORDER BY users.id, orders.id;
 _id | name  |       email       |        created_at        | _id | user_id | amount |  status   
-----+-------+-------------------+--------------------------+-----+---------+--------+-----------
   1 | Alice | alice@example.com | Thu Jan 01 10:00:00 2026 | 101 |       1 |  50.00 | paid
   1 | Alice | alice@example.com | Thu Jan 01 10:00:00 2026 | 102 |       1 |  75.50 | shipped
   2 | Bob   | bob@example.com   | Fri Jan 02 11:00:00 2026 | 103 |       2 |  20.00 | cancelled
(3 rows)

-- Subqueries with RENAME
SELECT * (RENAME (u.created_at AS date_created))
FROM (
    SELECT * FROM users
) u
ORDER BY id;
 id | name  |       email       |       date_created       
----+-------+-------------------+--------------------------
  1 | Alice | alice@example.com | Thu Jan 01 10:00:00 2026
  2 | Bob   | bob@example.com   | Fri Jan 02 11:00:00 2026
  3 | Carol |                   | Sat Jan 03 12:00:00 2026
(3 rows)

SELECT * (RENAME (j.created_at AS date_created))
FROM (
    users JOIN orders USING (id)
) AS j;
 id | name | email | date_created | user_id | amount | status 
----+------+-------+--------------+---------+--------+--------
(0 rows)

-- CTEs with RENAME
WITH base_users AS (
    SELECT * FROM users
)
SELECT * (RENAME (base_users.created_at AS date_created))
FROM base_users
ORDER BY id;
 id | name  |       email       |       date_created       
----+-------+-------------------+--------------------------
  1 | Alice | alice@example.com | Thu Jan 01 10:00:00 2026
  2 | Bob   | bob@example.com   | Fri Jan 02 11:00:00 2026
  3 | Carol |                   | Sat Jan 03 12:00:00 2026
(3 rows)

-- Multiple FROM items with RENAME
SELECT * (RENAME (email AS user_email, status AS order_status)) FROM users, orders ORDER BY users.id, orders.id;
 id | name  |    user_email     |        created_at        | id  | user_id | amount | order_status 
----+-------+-------------------+--------------------------+-----+---------+--------+--------------
  1 | Alice | alice@example.com | Thu Jan 01 10:00:00 2026 | 101 |       1 |  50.00 | paid
  1 | Alice | alice@example.com | Thu Jan 01 10:00:00 2026 | 102 |       1 |  75.50 | shipped
  1 | Alice | alice@example.com | Thu Jan 01 10:00:00 2026 | 103 |       2 |  20.00 | cancelled

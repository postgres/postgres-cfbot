-- hostile names: format-string metacharacters and embedded quotes must
-- pass through the fmt expansion inertly
CREATE TABLE deparse_tests."evil %{name}I table" (
"a""b" int,
"%{col}s" text DEFAULT 'O''Reilly',
"100%" numeric
);

step s3_await_defer: 
    DO $$
    DECLARE tries int := 0;
    BEGIN
        LOOP
            PERFORM 1 FROM pg_stat_activity
             WHERE wait_event = 'bt_load_defer_unique_check';
            EXIT WHEN FOUND;
            IF tries >= 1200 THEN
                RAISE 'the build did not reach the deferral point';
            END IF;
            PERFORM pg_sleep(0.05);
            tries := tries + 1;
        END LOOP;
    END $$;


# Configuration for operating the client CA at test time, to issue client
# certificates that expire a few seconds after they are issued.
#
# This signs with the committed client CA (the same certificate and key that
# cas.config uses), but keeps its index, serial and issued-certificate state
# in a scratch directory named by the SSL_TEST_CA_DIR environment variable,
# so that running a test never touches the committed ssl/ directory.  Paths
# are relative to src/test/ssl, as in cas.config.
#
# Certificates issued this way can't be committed: their validity is relative
# to the time the test runs, so there are no fixed dates to generate them
# with.  Everything else the tests use is generated by sslfiles.mk.

[ short_lived_client_ca ]
certificate = ./ssl/client_ca.crt
private_key = ./ssl/client_ca.key
database = $ENV::SSL_TEST_CA_DIR/index.txt
serial = $ENV::SSL_TEST_CA_DIR/serial.txt
new_certs_dir = $ENV::SSL_TEST_CA_DIR/newcerts
default_md = sha256
default_days = 1
policy = policy_match
email_in_dn = no
unique_subject = no

[ policy_match ]
commonName = supplied

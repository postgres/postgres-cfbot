# An OpenSSL format CSR config file for creating a client certificate with
# an empty subject and a single URI subject alternative name.  RFC 5280
# requires the subjectAltName extension to be critical when the subject is
# empty, and the CSR recipe in sslfiles.mk passes "-subj /" to express the
# empty subject.

[ req ]
distinguished_name     = req_distinguished_name
req_extensions         = v3_req
prompt                 = no

[ req_distinguished_name ]

[ v3_req ]
subjectAltName         = critical,URI:spiffe://postgresql.example/ns/default/sa/ssltestuser
